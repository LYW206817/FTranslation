[Unit]
Description=Fast Translation account and translation gateway
Documentation=https://github.com/LYW206817/FTranslation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ftserver
Group=ftserver
WorkingDirectory=/opt/fasttranslation

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# SQLite 文件必须放在只读的应用程序目录之外。
Environment=Server__DatabasePath=/var/lib/fasttranslation/fasttranslation.db

ExecStart=/opt/fasttranslation/FastTranslation.Server
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# 进程只允许写自己的状态目录，机器上其他地方
# 对它都是只读，这样服务端的 bug 也祸害不到系统。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/fasttranslation

[Install]
WantedBy=multi-user.target

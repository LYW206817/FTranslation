# Fast Translation —— 静态站点加 API 反向代理。
#
# 启用前先替换这两个占位符：
#   __DOMAIN__         ftranslation.cn —— 该标记在下面出现两次（裸域和
#                        www 别名），所以一条 sed 就能覆盖两个主机名
#   __ACME_EMAIL__     能接收证书到期提醒的邮箱
#
# 只在 ICP 备案号下来之后再动：备案前把域名指向大陆服务器会被封，
# 而且 ACME 无法为未备案的主机签发证书。
#   替换命令：sed -i 's/__DOMAIN__/ftranslation.cn/g; s/__ACME_EMAIL__/you@example.com/g' /etc/caddy/Caddyfile
#
# ECS 安全组必须放行 80 和 443 端口：Caddy 需要 80 来做
# ACME HTTP 校验，然后把所有流量重定向到 443。
{
	email __ACME_EMAIL__
	admin off
}

__DOMAIN__ www.__DOMAIN__ {
	encode zstd gzip

	# 静态资源的文件名永远不变，所以让浏览器缓存一年。
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML 外壳必须重新校验，否则部署完用户看不到。
	@document path / /index.html /robots.txt
	header @document Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 运营后台与官网分开 root：admin/ 的发布节奏跟着运维走，
	# 不能被站点整目录同步顺手覆盖。页面没有构建步骤，直接 file_server。
	# 必须补尾斜杠：否则页面里的 ./admin.css 会解析到站点根。
	redir /admin /admin/ 308
	handle_path /admin/* {
		root * /var/www/fasttranslation-admin
		file_server
		header {
			Cache-Control "no-store"
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			X-Robots-Tag "noindex, nofollow"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		}
		# 可选第二层：Basic Auth 只能挡住不知道口令的人先看到登录页，
		# 真正的授权仍是页面里输入的 X-Admin-Token。启用前先
		# `caddy hash-password`，再把下面三行取消注释：
		# basic_auth {
		# 	admin <bcrypt-hash>
		# }
	}

	# 账号 API、开发者网关和健康探针都落在同一个 Kestrel 实例上，
	# 该实例只监听回环地址。
	handle /v1/* {
		reverse_proxy 127.0.0.1:5080
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:5080
	}
	handle /health {
		reverse_proxy 127.0.0.1:5080
	}

	handle {
		root * /var/www/fasttranslation
		try_files {path} /index.html
		file_server
	}
}

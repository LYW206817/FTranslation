{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Server": {
    "SigningKey": "__BASE64_32_BYTES__",
    "AdminToken": "__LONG_RANDOM_ADMIN_TOKEN__",
    "RequireEmailVerification": false,
    "Smtp": {
      "Host": "__SMTP_HOST__",
      "Port": 587,
      "UseStartTls": true,
      "User": "__SMTP_USER__",
      "Password": "__SMTP_PASSWORD__",
      "From": "__SMTP_FROM__"
    },
    "Gateway": {
      "Enabled": true,
      "ApiKey": "__DASHSCOPE_API_KEY__",
      "DailyBudgetMicros": 5000000,
      "Speech": {
        "Enabled": true,
        "WsUrl": "wss://__WORKSPACE_ID__.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference",
        "WorkspaceId": "__WORKSPACE_ID__",
        "Model": "qwen-audio-3.1-asr-flash-streaming",
        "QuotaCharsPerSecond": 20,
        "MinSeconds": 10,
        "MaxSecondsPerSession": 1800,
        "MaxConcurrentSessionsPerUser": 1,
        "DailyBudgetMicros": 2000000
      }
    }
  }
}

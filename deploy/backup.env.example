# /etc/fasttranslation/backup.env
# 由 install.sh 首次安装时从 deploy/backup.env.example 复制，权限 600。
# 默认只做本机备份；填齐下面的值并把 FT_BACKUP_OFFSITE 改成 1 才会启用异地备份。

# 0 = 只写 /var/backups/fasttranslation；1 = 额外上传 age 密文到 OSS
FT_BACKUP_OFFSITE=0

# age 公钥（age1...）。私钥留在你的电脑或密码管理器，不要放到服务器上。
# 生成：age-keygen -o ft-backup-age.key（公钥会打印在 stderr）
FT_BACKUP_AGE_RECIPIENT=

# 阿里云 OSS：私有 Bucket，建议与 ECS 同地域，并设置生命周期保留 90 天。
# 只给这个 AccessKey 该 Bucket 下前缀的 PutObject 权限。
FT_OSS_BUCKET=__OSS_BUCKET__
FT_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
FT_OSS_PREFIX=fasttranslation
FT_OSS_ACCESS_KEY_ID=__OSS_ACCESS_KEY_ID__
FT_OSS_ACCESS_KEY_SECRET=__OSS_ACCESS_KEY_SECRET__

# 只在本机演练加密与对象路径、不上传时临时改成 1
# FT_BACKUP_OFFSITE_DRY_RUN=1
# 复制到 /etc/fasttranslation/monitor.env，chmod 600，只留服务器上。
# 真实 webhook / 探针密码绝不进仓库，也不贴进对话或截图。
#
# 首次安装时 install.sh 会把这份示例复制成 /etc/fasttranslation/monitor.env；
# 填好下面两个 __ 占位符后，执行：
#   bash /usr/local/bin/ft-provision-probe.sh
# 然后手工跑一次：
#   /usr/local/bin/ft-probe.sh
#   /usr/local/bin/ft-monitor.sh digest

# 探测走 loopback，不依赖域名、备案或 HTTPS 是否就绪。
FT_BASE_URL=http://127.0.0.1:5080
FT_PROBE_EMAIL=probe@example.com

# 用 openssl rand -hex 16 生成；同时记进密码管理器。
FT_PROBE_PASSWORD=__PROBE_PASSWORD__

# 飞书群机器人 webhook；安全设置选「自定义关键词」，关键词与下面一致。
FT_FEISHU_WEBHOOK=__FEISHU_WEBHOOK__
FT_ALERT_KEYWORD=FastTranslation

# 状态目录用于告警去重；默认即可。
FT_STATE_DIR=/var/lib/fasttranslation-monitor
FT_REPEAT_SECONDS=21600

# 数据库、生产配置、备份目录；与 systemd / backup.sh 的默认保持一致。
FT_DB=/var/lib/fasttranslation/fasttranslation.db
FT_CONFIG=/opt/fasttranslation/appsettings.Production.json
FT_BACKUP_DIR=/var/backups/fasttranslation
FT_BACKUP_MAX_AGE_HOURS=36
FT_DISK_MAX_PERCENT=85
FT_BUDGET_ALERT_PERCENT=80

# 调试时设为 1：只打印消息，不真的发飞书。
# FT_DRY_RUN=1

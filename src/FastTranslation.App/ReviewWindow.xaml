<Window x:Class="FastTranslation.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="复习 - Fast Translation" Icon="/FastTranslation.ico"
        Width="880" Height="600" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="NextLabel" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header: title + progress + skip -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,0,1"
            Padding="24,14,24,13">
      <DockPanel>
        <TextBlock Text="今日复习" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
        <Button x:Name="SkipButton" DockPanel.Dock="Right" Content="跳过" Margin="0,0,14,0"
                Style="{StaticResource SmallButton}" Click="Skip_Click"/>
        <TextBlock Text=" " />
      </DockPanel>
    </Border>

    <!-- card -->
    <Grid x:Name="CardHost" Grid.Row="1" Margin="40,20,40,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- the card itself: the thing being tested on top, the answer slot below it. The slot has to
           sit UNDER the text, not over it: a mask painted across the middle hid the word it was
           asking about. -->
      <StackPanel Grid.Row="0" VerticalAlignment="Center">
        <TextBlock x:Name="PromptText" FontSize="21" LineHeight="34"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <Grid x:Name="RevealSlot" Margin="0,24,0,0" MaxWidth="520" HorizontalAlignment="Center">
          <!-- mask state: the blank slot you click to flip -->
          <Grid x:Name="RevealMask" Background="Transparent" Cursor="Hand"
                MouseLeftButtonUp="Reveal_Click" MaxWidth="460">
            <Rectangle RadiusX="10" RadiusY="10" Fill="Transparent"
                       Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                       StrokeDashArray="3 2"/>
            <StackPanel Margin="30,20" VerticalAlignment="Center">
              <TextBlock Text="点击看译文" FontSize="14" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Text="看完再按 1 / 2 / 3 / 4 评记忆程度" FontSize="11" Margin="0,8,0,0"
                         HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
          </Grid>

          <!-- revealed: translation + where it came from + your note -->
          <ScrollViewer x:Name="AnswerPanel" Visibility="Collapsed" MaxHeight="260"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Height="1" Background="{DynamicResource HairBrush}" Width="120"
                      HorizontalAlignment="Center" Margin="0,0,0,16"/>
              <TextBlock x:Name="AnswerText" FontSize="17" LineHeight="28" TextWrapping="Wrap"
                         TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock x:Name="OriginText" FontSize="11" Margin="0,14,0,0" TextAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="AnnotationText" FontSize="12" Margin="0,8,0,0" TextAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </StackPanel>

      <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,12,0,0" TextAlignment="Center"
                 FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
    </Grid>

    <!-- empty state shares the card row -->
    <StackPanel x:Name="EmptyPanel" Grid.Row="1" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
      <TextBlock x:Name="EmptyText" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"
                 LineHeight="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
      <Button x:Name="EmptyNotesButton" Content="再看看单词本" Margin="0,16,0,0" Padding="14,6"
              HorizontalAlignment="Center" Click="Notes_Click"/>
    </StackPanel>

    <!-- four grades; greyed out until the answer is visible. Focusable="False" on purpose: the
         keyboard path is 1/2/3/4, and a focusable button would both steal Space (which reveals)
         and leave a focus ring behind after a mouse click. -->
    <Border x:Name="GradeBar" Grid.Row="2" BorderBrush="{DynamicResource HairBrush}"
            BorderThickness="0,1,0,0" Padding="24,12,24,16">
      <StackPanel>
        <TextBlock x:Name="KeysHint" Style="{StaticResource Hint}" HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   Text="空格 看译文 · 1 忘记 · 2 模糊 · 3 熟悉 · 4 记住 · 跳过不算评过"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <Button x:Name="ForgotButton" Focusable="False" Tag="forgot" Content="忘记" Height="38"
                    Click="Grade_Click" IsEnabled="False"/>
            <TextBlock x:Name="ForgotNext" Style="{StaticResource NextLabel}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Button x:Name="FuzzyButton" Focusable="False" Tag="fuzzy" Content="模糊" Height="38"
                    Click="Grade_Click" IsEnabled="False"/>
            <TextBlock x:Name="FuzzyNext" Style="{StaticResource NextLabel}"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <Button x:Name="FamiliarButton" Focusable="False" Tag="familiar" Content="熟悉" Height="38"
                    Click="Grade_Click" IsEnabled="False"/>
            <TextBlock x:Name="FamiliarNext" Style="{StaticResource NextLabel}"/>
          </StackPanel>
          <StackPanel Grid.Column="6">
            <Button x:Name="KnownButton" Focusable="False" Tag="known" Content="记住" Height="38"
                    Click="Grade_Click" IsEnabled="False"/>
            <TextBlock x:Name="KnownNext" Style="{StaticResource NextLabel}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>

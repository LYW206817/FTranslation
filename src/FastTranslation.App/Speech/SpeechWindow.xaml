<!-- v106: 字幕要压在播放器/会议窗口上方。用户点到浏览器或播放器后，浮窗不能沉到后面去；
     Show() 本身不保证层级，所以必须显式 Topmost。 -->
<Window x:Class="FastTranslation.App.Speech.SpeechWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="语音翻译" Width="720" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanMinimize" Topmost="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>
  <!-- 可激活浮窗（区别于结果卡）：用户要拖它、点按钮，所以不加 WS_EX_NOACTIVATE；
       字幕更新走 Background 优先级，出字不打断用户正在做的事 -->
  <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
          Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 头部：状态点 + 计时 + 用量 + 关闭 -->
      <Border Grid.Row="0" Background="Transparent" Padding="14,10,10,10"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{DynamicResource BrandBrush}"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="StateText" Text="语音翻译" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ElapsedText" Margin="10,0,0,0" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="UsageText" Grid.Column="2" Margin="0,0,10,0" FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
          <Button x:Name="CloseButton" Grid.Column="3" Content="✕" Width="26" Height="26"
                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                  Click="Close_Click"/>
        </Grid>
      </Border>

      <!-- 字幕流：新行在底部，自动滚到最下 -->
      <ScrollViewer x:Name="LineScroll" Grid.Row="1" Padding="14,0,14,6"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="LineList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,6">
                <TextBlock x:Name="SourceText" Text="{Binding Source}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding SourceVisibility}"/>
                <TextBlock Text="{Binding Target}" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Opacity="{Binding FinalOpacity}"
                           Visibility="{Binding TargetVisibility}"/>
                <!-- v106: 翻译失败或队列丢弃的终稿行没有 Target。留空行会让用户以为字幕丢了；
                     显式标「未翻译」，原文仍在上面，用户知道是没译成而不是没听到。 -->
                <TextBlock Text="未翻译" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding UntranslatedVisibility}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 底部：结束 / 暂停继续 / 清空 -->
      <Border Grid.Row="2" Padding="14,8,14,12" BorderBrush="{DynamicResource HairBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="StopButton" Content="结束" Style="{StaticResource PrimaryButton}"
                  Padding="18,5" Click="Stop_Click"/>
          <!-- 暂停↔继续 一键双语义，和 StopButton 的 结束↔关闭 同一先例 -->
          <Button x:Name="PauseButton" Content="暂停" Margin="8,0,0,0" Padding="18,5" Click="Pause_Click"/>
          <Button x:Name="ClearButton" Content="清空" Margin="8,0,0,0" Padding="14,5" Click="Clear_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>

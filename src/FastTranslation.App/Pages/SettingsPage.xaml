<UserControl x:Class="FastTranslation.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>
    <!-- v91：行式设置的三件套——行容器、左侧标题、标题下那行灰说明。 -->
    <Style x:Key="SRow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="0,10"/>
    </Style>

    <!-- v111：右侧控件统一留 4px 右外边距。焦点环是 2px、画在控件外 3px（模板 Margin=-3），
         控件贴住卡片内容右边缘时，环的右半边会被卡片的视觉裁剪吃掉（用户反馈）。这 4px
         不是留白偏好，是给焦点环的呼吸位；新增右侧贴边的输入类控件也要带上。 -->

    <Style x:Key="SKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SDesc" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>


    <!-- 强调色选择：一枚色块 + 名字，选中态由代码改 BorderBrush/Brush（画刷来自
         ThemePalette，XAML 里不写裸色值） -->
    <Style x:Key="AccentChip" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentChipDot" TargetType="Border">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 卡片内紧贴其输入框上方的标签 -->
    <Style x:Key="ExclusionItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandFillBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== 可滚动主体：每个关注点一张卡，分组按主题而不是按高度——左列是「它怎么为我
         翻译」，右列是「它在跟谁通信」；具体哪张卡进哪一列由 CardBoard 按最短列决定。
         小标题与它的卡包在同一个 StackPanel 里，否则会被分列拆成两半。 ===== -->
    <ScrollViewer x:Name="Body" Grid.Row="0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  Focusable="False" PreviewMouseWheel="Body_PreviewMouseWheel">
      <!-- v69：底边留够一行的高度。原来只留 6px，滚动到底时最后那张卡的
           脚注会被视口边缘切成半行。 -->
      <StackPanel x:Name="BodyStack" Margin="28,22,28,26" MaxWidth="1440" HorizontalAlignment="Center">
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="设置"/>
            <TextBlock Style="{StaticResource PageSub}"
                       Text="主题与强调色选完立即生效；热键在下次启动后生效。"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource TopPill}" VerticalAlignment="Top">
            <TextBlock Text="本机设置 · 不随账号同步" FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </Border>
        </Grid>

        <!-- v91：按效果图改成行式：左边一行标题(可带一行灰说明)、右边是它控制的那个控件，
             行与行之间只有一道发丝线。原来「标签在上、控件在下」的堆叠在宽窗口里要在标签
             和控件之间来回扫一遍才敢确认，行式把标题和控件压在同一条水平线上。 -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="翻译与外观" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>

            <Border Style="{StaticResource SRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="目标语言" Style="{StaticResource SKey}"/>
                <local:FtComboBox x:Name="TargetCombo" Grid.Column="1" Width="170" Margin="0,0,4,0"
                                  SelectionChanged="TargetCombo_SelectionChanged"
                                  AutomationProperties.Name="目标语言"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource SRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="模型" Style="{StaticResource SKey}"/>
                <local:FtComboBox x:Name="ModelCombo" Grid.Column="1" Width="210" Margin="0,0,4,0"
                                  AutomationProperties.Name="模型">
                  <ComboBoxItem Content="Flash(快速,默认)" Tag="qwen-mt-flash"/>
                  <ComboBoxItem Content="Plus(更高质量,消耗 2.7 倍额度)" Tag="qwen-mt-plus"/>
                  <ComboBoxItem Content="Lite(最省额度,消耗 0.85 倍额度)" Tag="qwen-mt-lite"/>
                </local:FtComboBox>
              </Grid>
            </Border>

            <Border Style="{StaticResource SRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="主题" Style="{StaticResource SKey}"/>
                <local:FtComboBox x:Name="ThemeCombo" Grid.Column="1" Width="170" Margin="0,0,4,0"
                                  SelectionChanged="ThemeCombo_SelectionChanged"
                                  AutomationProperties.Name="主题">
                  <ComboBoxItem Content="跟随系统"/>
                  <ComboBoxItem Content="浅色"/>
                  <ComboBoxItem Content="深色"/>
                </local:FtComboBox>
              </Grid>
            </Border>

            <Border Style="{StaticResource SRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="强调色" Style="{StaticResource SKey}"/>
                  <TextBlock Text="色块显示的是该色在当前主题下的品牌色。" Style="{StaticResource SDesc}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="AccentElectroChip" Tag="electro" Style="{StaticResource AccentChip}"
                          Click="AccentChip_Click" AutomationProperties.Name="强调色 电光蓝">
                    <StackPanel Orientation="Horizontal">
                      <Border x:Name="AccentElectroDot" Style="{StaticResource AccentChipDot}"/>
                      <TextBlock Text="电光蓝" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="AccentLakeChip" Tag="lake" Style="{StaticResource AccentChip}"
                          Click="AccentChip_Click" AutomationProperties.Name="强调色 湖蓝">
                    <StackPanel Orientation="Horizontal">
                      <Border x:Name="AccentLakeDot" Style="{StaticResource AccentChipDot}"/>
                      <TextBlock Text="湖蓝" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="AccentVioletChip" Tag="violet" Style="{StaticResource AccentChip}"
                          Click="AccentChip_Click" AutomationProperties.Name="强调色 雾光紫">
                    <StackPanel Orientation="Horizontal">
                      <Border x:Name="AccentVioletDot" Style="{StaticResource AccentChipDot}"/>
                      <TextBlock Text="雾光紫" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource SRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="划词热键" Style="{StaticResource SKey}"/>
                <TextBox x:Name="HotkeyBox" Grid.Column="1" Width="170" Margin="0,0,4,0" Text="Ctrl+Alt+T"
                         AutomationProperties.Name="划词热键"/>
              </Grid>
            </Border>
            <TextBlock x:Name="HotkeyError" Text="" FontSize="12"
                       Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="服务" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>

            <Border Style="{StaticResource SRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="API Key" Style="{StaticResource SKey}"/>
                  <TextBlock Text="留空表示不修改;已保存的 Key 使用 Windows DPAPI 加密在本机存储。"
                             Style="{StaticResource SDesc}"/>
                </StackPanel>
                <PasswordBox x:Name="KeyBox" Grid.Column="1" Width="300" Margin="0,0,4,0"
                             AutomationProperties.Name="API Key"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource SRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="自定义服务地址" Style="{StaticResource SKey}"/>
                  <TextBlock Text="留空使用默认 DashScope 地址。" Style="{StaticResource SDesc}"/>
                </StackPanel>
                <TextBox x:Name="BaseUrlBox" Grid.Column="1" Width="300" Margin="0,0,4,0"
                         AutomationProperties.Name="自定义服务地址"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource SRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="账号服务地址" Style="{StaticResource SKey}"/>
                  <TextBlock Text="留空使用内置账号服务器;自建或测试服务器可在此填写。"
                             Style="{StaticResource SDesc}"/>
                </StackPanel>
                <TextBox x:Name="AccountUrlBox" Grid.Column="1" Width="300" Margin="0,0,4,0"
                         AutomationProperties.Name="账号服务地址"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- 两栏等高：Grid 的两张卡默认 VerticalAlignment=Stretch，行高取较高那张，
             短的那张会自动拉齐，不需要再用 CardBoard 那种按列宽分派的容器。 -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="0.9*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="取词与写回" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>

              <Border Style="{StaticResource SRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="取词" Style="{StaticResource SKey}"/>
                    <TextBlock Text="取词失败时使用剪贴板兜底(Ctrl+C)。" Style="{StaticResource SDesc}"/>
                  </StackPanel>
                  <CheckBox x:Name="ClipboardFallbackCheck" Grid.Column="1" VerticalAlignment="Center"
                            AutomationProperties.Name="取词失败时使用剪贴板兜底"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource SRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="写回" Style="{StaticResource SKey}"/>
                    <TextBlock Text="启用替换原文，仅在可写文本框里生效。" Style="{StaticResource SDesc}"/>
                  </StackPanel>
                  <CheckBox x:Name="WriteBackCheck" Grid.Column="1" VerticalAlignment="Center"
                            AutomationProperties.Name="启用替换原文"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource SRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="排除应用" Style="{StaticResource SKey}"/>
                    <TextBlock Text="按进程名匹配(如 chrome、Code)，不区分大小写;这些应用里的划词与写回都不触发。"
                               Style="{StaticResource SDesc}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="ExclusionInput" Width="150" Margin="0,0,8,0"
                             AutomationProperties.Name="进程名"/>
                    <Button Content="添加" Style="{StaticResource SmallButton}" Margin="0"
                            Click="AddExclusion_Click"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource HairBrush}"
                      BorderThickness="1" CornerRadius="7" Padding="3" Margin="0,12,0,0">
                <Grid>
                  <TextBlock x:Name="ExclusionEmpty" Text="还没有排除任何应用"
                             FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                             Margin="9,9,0,0" IsHitTestVisible="False"/>
                  <ListBox x:Name="ExcludedList" MinHeight="42" MaxHeight="132"
                           BorderThickness="0" Background="Transparent" Padding="0"
                           ItemContainerStyle="{StaticResource ExclusionItem}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           AutomationProperties.Name="已排除的应用"/>
                </Grid>
              </Border>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="填入前台应用" Style="{StaticResource SmallButton}"
                        HorizontalAlignment="Left" Click="FillForeground_Click"/>
                <Button Grid.Column="1" Content="移除选中" Style="{StaticResource SmallButton}"
                        Margin="0" Click="RemoveExclusion_Click"/>
              </Grid>

              <TextBlock x:Name="ExclusionHint" Text="" FontSize="11" Visibility="Collapsed"
                         Foreground="{DynamicResource BrandTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="系统" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>

              <Border Style="{StaticResource SRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="开机自启" Style="{StaticResource SKey}"/>
                    <TextBlock Text="当前用户登录时启动。" Style="{StaticResource SDesc}"/>
                  </StackPanel>
                  <CheckBox x:Name="AutoStartCheck" Grid.Column="1" VerticalAlignment="Center"
                            AutomationProperties.Name="开机时自动启动"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource SRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="低内存模式" Style="{StaticResource SKey}"/>
                    <TextBlock Text="软件渲染，降低常驻内存，但界面重绘会变慢；默认关闭，下次启动生效。"
                               Style="{StaticResource SDesc}"/>
                  </StackPanel>
                  <CheckBox x:Name="SoftwareRenderingCheck" Grid.Column="1" VerticalAlignment="Center"
                            AutomationProperties.Name="低内存模式（软件渲染）"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource SRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="自动更新" Style="{StaticResource SKey}"/>
                    <TextBlock Text="发现新版本会提示下载并自动安装。" Style="{StaticResource SDesc}"/>
                  </StackPanel>
                  <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新"
                          Style="{StaticResource SmallButton}" Margin="0" Click="CheckUpdate_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource SRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="版本" Style="{StaticResource SKey}"/>
                  <TextBlock x:Name="AboutText" Grid.Column="1" MaxWidth="220" TextAlignment="Right"
                             FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
              </Border>
              <TextBlock x:Name="UpdateHint" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Text="发现新版本会提示下载并自动安装。"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== 固定底栏：保存/取消 永远不会滚走，细线标出边界。它在卡片区之外，
         所以不分列、整宽贴着窗口底；左边那行提示说的是：对一个绑定了账号的设置页，
         人们唯一会想错的那件事。 ===== -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0"
            Padding="24,11,24,12">
      <Grid MaxWidth="1440" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="这些设置只存在这台机器上,不随账号同步。"
                   FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"/>
          <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="FastTranslation.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             Background="{DynamicResource WindowBgBrush}"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>
    <!-- section heading above a card: small, quiet, and the only thing separating groups -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,13,14,14"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- label directly above its input inside a card -->
    <Style x:Key="FieldLabelTight" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- compact secondary action used inside the exclusion card -->
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="ExclusionItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="8,5" Margin="0,1,0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandFillBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- page title only: the page has no border of its own inside the shell -->
    <TextBlock Grid.Row="0" Text="设置" FontSize="17" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}" Margin="24,18,24,12"/>

    <!-- ===== scrolling body: one card per concern, real padding at both edges so no
         control is ever sliced in half by the viewport ===== -->
    <ScrollViewer x:Name="Body" Grid.Row="1"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" PreviewMouseWheel="Body_PreviewMouseWheel">
      <StackPanel x:Name="BodyStack" Margin="24,0,18,6" MaxWidth="760" HorizontalAlignment="Left">

        <TextBlock Text="翻译与外观" Style="{StaticResource GroupLabel}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="目标语言" Style="{StaticResource FieldLabelTight}"/>
                <local:FtComboBox x:Name="TargetCombo" SelectionChanged="TargetCombo_SelectionChanged"
                                  AutomationProperties.Name="目标语言"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="模型" Style="{StaticResource FieldLabelTight}"/>
                <local:FtComboBox x:Name="ModelCombo" AutomationProperties.Name="模型">
                  <ComboBoxItem Content="Flash(快速,默认)"/>
                  <ComboBoxItem Content="Plus(更高质量)"/>
                </local:FtComboBox>
              </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="主题" Style="{StaticResource FieldLabelTight}"/>
                <local:FtComboBox x:Name="ThemeCombo" AutomationProperties.Name="主题">
                  <ComboBoxItem Content="跟随系统"/>
                  <ComboBoxItem Content="浅色"/>
                  <ComboBoxItem Content="深色"/>
                </local:FtComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="划词热键" Style="{StaticResource FieldLabelTight}"/>
                <TextBox x:Name="HotkeyBox" Text="Ctrl+Alt+T" AutomationProperties.Name="划词热键"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="主题与热键均在下次启动后生效" Style="{StaticResource Hint}"/>
            <TextBlock x:Name="HotkeyError" Text="" FontSize="12"
                       Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="取词与写回" Style="{StaticResource GroupLabel}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <CheckBox x:Name="ClipboardFallbackCheck" Content="取词失败时使用剪贴板兜底(Ctrl+C)"/>
            <CheckBox x:Name="WriteBackCheck" Content="启用替换原文(仅在可写文本框)" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="服务" Style="{StaticResource GroupLabel}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="API Key" Style="{StaticResource FieldLabelTight}"/>
            <PasswordBox x:Name="KeyBox" AutomationProperties.Name="API Key"/>
            <TextBlock Text="留空表示不修改;已保存的 Key 使用 Windows DPAPI 加密在本机存储。" Style="{StaticResource Hint}"/>

            <TextBlock Text="自定义服务地址(可选)" Style="{StaticResource FieldLabelTight}" Margin="0,14,0,6"/>
            <TextBox x:Name="BaseUrlBox" AutomationProperties.Name="自定义服务地址"/>
            <TextBlock Text="留空使用默认 DashScope 地址。" Style="{StaticResource Hint}"/>

            <TextBlock Text="账号服务地址(可选)" Style="{StaticResource FieldLabelTight}" Margin="0,14,0,6"/>
            <TextBox x:Name="AccountUrlBox" AutomationProperties.Name="账号服务地址"/>
            <TextBlock Text="留空使用内置账号服务器;自建或测试服务器可在此填写。" Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>

        <TextBlock Text="排除应用" Style="{StaticResource GroupLabel}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource HairBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="3">
              <Grid>
                <TextBlock x:Name="ExclusionEmpty" Text="还没有排除任何应用"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="9,9,0,0" IsHitTestVisible="False"/>
                <ListBox x:Name="ExcludedList" MinHeight="42" MaxHeight="132"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         ItemContainerStyle="{StaticResource ExclusionItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="已排除的应用"/>
              </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ExclusionInput" Grid.Column="0" Margin="0,0,8,0"
                       AutomationProperties.Name="进程名"/>
              <Button Grid.Column="1" Content="添加" Click="AddExclusion_Click" Margin="0"/>
            </Grid>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="填入前台应用" Style="{StaticResource SmallButton}"
                      HorizontalAlignment="Left" Click="FillForeground_Click"/>
              <Button Grid.Column="1" Content="移除选中" Style="{StaticResource SmallButton}"
                      Margin="0" Click="RemoveExclusion_Click"/>
            </Grid>

            <TextBlock x:Name="ExclusionHint" Text="" FontSize="11" Visibility="Collapsed"
                       Foreground="{DynamicResource BrandBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="按进程名匹配(如 chrome、Code),不区分大小写;这些应用里的划词与写回都不触发。"
                       Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>

        <TextBlock Text="系统" Style="{StaticResource GroupLabel}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <CheckBox x:Name="AutoStartCheck" Content="开机时自动启动(当前用户)"/>
            <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="CheckUpdateButton" Grid.Column="0" Content="检查更新"
                      Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                      Click="CheckUpdate_Click"/>
              <TextBlock x:Name="UpdateHint" Grid.Column="1" Margin="10,0,0,0" FontSize="11"
                         VerticalAlignment="Center" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Text="发现新版本会提示下载并自动安装。"/>
            </Grid>
            <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12"/>
            <TextBlock x:Name="AboutText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ===== fixed footer: 保存/取消 never scroll away, and the hairline marks the boundary ===== -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0"
            Padding="24,11,24,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
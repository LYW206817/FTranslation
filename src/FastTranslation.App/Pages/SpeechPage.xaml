<UserControl x:Class="FastTranslation.App.Pages.SpeechPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <!-- 页面只负责「开始前」的设置与会话入口；会话中的字幕在 SpeechWindow 浮窗，主窗口不重复承担 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" Focusable="False">
    <!-- 标题整宽在页顶；语音页在效果图里是整宽单列，所以 Columns=1 -->
    <StackPanel MaxWidth="1440" Margin="24,18,24,26" HorizontalAlignment="Center">
      <TextBlock Text="语音翻译" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
      <local:CardBoard Columns="1">

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="开始"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="StartButton" Content="开始语音翻译" Style="{StaticResource PrimaryButton}"
                      Padding="20,6" Click="Start_Click"/>
              <TextBlock x:Name="StateText" Text="未开始" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
            <TextBlock x:Name="QuotaText" Style="{StaticResource Hint}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="开启后，电脑里正在播放的声音（会议、视频、通话）会被实时转成字幕并翻译。采集的是系统回环声音；音频会经服务端转发给识别接口，服务端不保存音频，只记录本次会话的用量。"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="设置"/>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
              </Grid.RowDefinitions>
              <TextBlock Text="翻译成" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
              <local:FtComboBox x:Name="TargetCombo" Grid.Column="1" Width="200"
                                HorizontalAlignment="Left"
                                SelectionChanged="TargetCombo_SelectionChanged"/>
              <TextBlock Grid.Row="1" Text="显示原文" Style="{StaticResource FieldLabel}"
                         VerticalAlignment="Center"/>
              <CheckBox x:Name="ShowSourceToggle" Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                        Checked="ShowSource_Changed" Unchecked="ShowSource_Changed"/>
              <TextBlock Grid.Row="2" Text="字幕条数" Style="{StaticResource FieldLabel}"
                         VerticalAlignment="Center"/>
              <local:FtComboBox x:Name="MaxSentencesCombo" Grid.Row="2" Grid.Column="1" Width="120"
                                HorizontalAlignment="Left"
                                SelectionChanged="MaxSentences_SelectionChanged"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="字幕条数是浮窗里最多保留的字幕行，超出的最旧行会被移走，只影响显示，不影响翻译。"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="快捷键"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="HotkeyBox" Width="200" Padding="8,5"
                       LostFocus="HotkeyBox_LostFocus"/>
              <TextBlock x:Name="HotkeyHint" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="点击输入框后按下想要的组合键即可；语音翻译进行中按它会结束本轮。"/>
          </StackPanel>
        </Border>
      </local:CardBoard>
    </StackPanel>
  </ScrollViewer>
</UserControl>

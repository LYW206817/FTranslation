<UserControl x:Class="FastTranslation.App.Pages.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>

    <Style x:Key="MeterBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="3" HorizontalAlignment="Left"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- v111：登录成功时「登录」按钮随未登录面板一起收起，键盘焦点落到这个 ScrollViewer 上，
       WPF 会围绕整个账号页画出默认的深色焦点框（用户反馈的那一圈）。它不参与 Tab 导航，
       不需要焦点指示；关掉后子控件自己的焦点环不受影响。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" Focusable="False"
                FocusVisualStyle="{x:Null}">
    <!-- 账号页在效果图里是整宽单列：卡片一张压一张，只有未登录的那个表单保留左右并排 -->
    <StackPanel MaxWidth="1440" Margin="24,18,24,26" HorizontalAlignment="Center">
      <TextBlock x:Name="Headline" Text="账号" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

      <local:CardBoard Columns="1">
        <!-- ================= 未登录 ================= -->
        <Grid x:Name="SignedOutPanel">
          <!-- v111：未登录原来是一张表单卡 + 一张说明卡并排，两张卡高度差太多，页面看起来
               是半空的。改成一张左右分栏的 hero 卡：左列只放登录这一个主任务，右列把
               「登录后拿到什么」讲清楚。外层 Card 不裁切，所以渐变面板自己收右侧两角。 -->
          <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*"/>
                <ColumnDefinition Width="0.88*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="28,24,28,26">
                <TextBlock x:Name="FormTitle" Text="登录账号" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ModeHint" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="登录后免费额度、生词本与复习进度都跟着账号同步。"/>

                <TextBlock Text="邮箱" Style="{StaticResource FieldLabelTight}" Margin="0,22,0,6"/>
                <TextBox x:Name="EmailBox" AutomationProperties.Name="邮箱" TextChanged="Input_Changed"/>

                <TextBlock Text="密码" Style="{StaticResource FieldLabelTight}" Margin="0,14,0,6"/>
                <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="密码"
                             PasswordChanged="Password_Changed"/>
                <TextBlock x:Name="PasswordHint" Style="{StaticResource Hint}"
                           Text="至少 8 位。忘记密码暂时需要联系我们重置。"/>

                <StackPanel x:Name="CodeRow" Visibility="Collapsed">
                  <TextBlock Text="邮箱验证码" Style="{StaticResource FieldLabelTight}" Margin="0,14,0,6"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CodeBox" AutomationProperties.Name="验证码" MaxLength="6"/>
                    <Button x:Name="SendCodeButton" Grid.Column="1" Content="获取验证码" Margin="8,0,0,0"
                            Style="{StaticResource SmallButton}" Click="SendCode_Click"/>
                  </Grid>
                  <TextBlock x:Name="CodeHint" Style="{StaticResource Hint}"
                             Text="验证码 10 分钟内有效，会发到上面的邮箱。"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Style="{StaticResource Hint}"
                           Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>

                <Button x:Name="SubmitButton" Content="登录" Height="38" Margin="0,20,0,0"
                        HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"
                        Click="Submit_Click"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <TextBlock x:Name="SwitchPrompt" Text="还没有账号？" FontSize="12.5"
                             VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                  <Button x:Name="SwitchButton" Content="去注册" Margin="2,0,0,0"
                          Style="{StaticResource FlatLinkButton}" Click="Switch_Click"/>
                </StackPanel>
              </StackPanel>

              <!-- 右列：渐变底 + 左侧发丝线，和套餐页的 hero 用同一套做法（单独收圆角，
                   不再给外层加 ClipToBounds——矩形裁切会把投影切出四块三角残影）。 -->
              <Border Grid.Column="1" Background="{DynamicResource HeroPanelBrush}"
                      BorderBrush="{DynamicResource HairBrush}" BorderThickness="1,0,0,0"
                      CornerRadius="0,16,16,0" Padding="28,26,28,26">
                <StackPanel VerticalAlignment="Center">
                  <Border Width="42" Height="42" CornerRadius="21" HorizontalAlignment="Left"
                          Background="{DynamicResource BrandFillBrush}">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="17" Foreground="{DynamicResource BrandTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="登录后，这些跟着你走" FontSize="15" FontWeight="SemiBold"
                             Margin="0,14,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>

                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Foreground="{DynamicResource BrandBrush}"
                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock Text="免费额度按账号累计" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="不登录也能翻译，但用量只记在本机上，换台机器就找不回来。"
                                 Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Foreground="{DynamicResource BrandBrush}"
                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock Text="生词本存在服务端" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="保存的单词、短语、语句都在账号里，重装或换机器都还在。"
                                 Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Foreground="{DynamicResource BrandBrush}"
                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock Text="复习进度跟着账号走" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="每条记到第几档、下次什么时候再看，都记在账号上。"
                                 Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="每个账号最多 3 台设备，换新电脑前先移除不用的那台即可。"
                             Style="{StaticResource Hint}" Margin="0,18,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- ================= 已登录 ================= -->
        <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">

          <!-- 身份区：头像、名字、地址、套餐徽标，以及唯一一个破坏性操作 -->
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center"
                      Background="{DynamicResource BrandFillBrush}">
                <TextBlock x:Name="AvatarText" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                  <Border x:Name="PlanBadge" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="9"
                          Background="{DynamicResource BrandFillBrush}" Padding="7,2">
                    <TextBlock x:Name="PlanBadgeText" FontSize="11"
                               Foreground="{DynamicResource BrandTextBrush}"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="EmailText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource SmallButton}"
                        Click="Refresh_Click"/>
                <Button x:Name="SignOutButton" Content="退出登录" Margin="0" Click="SignOut_Click"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 套餐摘要：名称、有效期、剩余量。购买在套餐页 -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="当前套餐" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="PlanNameText" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock x:Name="PlanValidityText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

              <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0"
                      Margin="0,12,0,10"/>

              <TextBlock Text="本月剩余" Style="{StaticResource FieldLabelTight}"/>
              <TextBlock x:Name="MonthlyLeftText" FontSize="13"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <ProgressBar x:Name="MonthlyBar" Style="{StaticResource MeterBar}"/>

              <StackPanel x:Name="DailyRow" Margin="0,12,0,0">
                <TextBlock Text="今日剩余" Style="{StaticResource FieldLabelTight}"/>
                <TextBlock x:Name="DailyLeftText" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ProgressBar x:Name="DailyBar" Style="{StaticResource MeterBar}"/>
              </StackPanel>

              <Button x:Name="GotoPlanButton" Content="看套餐与价格" HorizontalAlignment="Left"
                      Style="{StaticResource SmallButton}" Margin="0,14,0,0" Click="GotoPlan_Click"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="登录设备" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="DeviceCountText" Grid.Column="1" Style="{StaticResource Hint}"
                           Margin="0" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="DeviceLimitHint" Style="{StaticResource Hint}" Margin="0,0,0,4"
                         Text="换新电脑前，先移除不用的设备，把名额空出来。"/>

              <ItemsControl x:Name="DeviceItems">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0"
                            Padding="0,9">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Background="{DynamicResource BrandFillBrush}" CornerRadius="4"
                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CurrentBadgeVisibility}">
                              <TextBlock Text="当前" FontSize="10"
                                         Foreground="{DynamicResource BrandTextBrush}"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding DetailLine}" Style="{StaticResource Hint}"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="移除" Tag="{Binding Id}"
                                Style="{StaticResource SmallButton}" Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding RemoveVisibility}"
                                Click="RemoveDevice_Click"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="DeviceEmptyText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                         Text="设备列表读取中…"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="修改名称" Style="{StaticResource CardTitle}"/>
              <TextBox x:Name="NameBox" AutomationProperties.Name="名称" MaxLength="24"
                       TextChanged="Input_Changed"/>
              <TextBlock Text="最多 24 个字。留空就用邮箱当地址显示。" Style="{StaticResource Hint}"/>
              <Button x:Name="SaveNameButton" Content="保存名称" HorizontalAlignment="Left"
                      Style="{StaticResource SmallButton}" Margin="0,10,0,0" Click="SaveName_Click"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="修改密码" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="当前密码" Style="{StaticResource FieldLabelTight}"/>
              <PasswordBox x:Name="CurrentPasswordBox" AutomationProperties.Name="当前密码"/>

              <TextBlock Text="新密码" Style="{StaticResource FieldLabelTight}" Margin="0,12,0,6"/>
              <PasswordBox x:Name="NewPasswordBox" AutomationProperties.Name="新密码"/>

              <TextBlock Text="再输一次" Style="{StaticResource FieldLabelTight}" Margin="0,12,0,6"/>
              <PasswordBox x:Name="ConfirmPasswordBox" AutomationProperties.Name="确认新密码"/>

              <TextBlock Text="至少 8 位。改完之后其他设备要重新登录,这台不用。"
                         Style="{StaticResource Hint}"/>
              <Button x:Name="SavePasswordButton" Content="保存密码" HorizontalAlignment="Left"
                      Style="{StaticResource SmallButton}" Margin="0,10,0,0" Click="SavePassword_Click"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="数据" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="生词本、复习进度都存在服务端,退出登录不会删掉,换机器登录同一个账号就能拿回来。"
                         Style="{StaticResource Hint}" Margin="0"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="2,0,2,0"/>
        </StackPanel>
      </local:CardBoard>
    </StackPanel>
  </ScrollViewer>
</UserControl>

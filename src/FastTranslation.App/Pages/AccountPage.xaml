<UserControl x:Class="FastTranslation.App.Pages.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             xmlns:win="clr-namespace:FastTranslation.Platform.Windows;assembly=FastTranslation.Platform.Windows"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>

    <Style x:Key="MeterBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="3" HorizontalAlignment="Left"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- v111：登录成功时「登录」按钮随未登录面板一起收起，键盘焦点落到这个 ScrollViewer 上，
       WPF 会围绕整个账号页画出默认的深色焦点框（用户反馈的那一圈）。它不参与 Tab 导航，
       不需要焦点指示；关掉后子控件自己的焦点环不受影响。
       v188：页内多个全宽 PasswordBox/TextBox 自带 PART_ContentHost ScrollViewer 会吞掉滚轮，
       启用 ScrollViewerWheel.Forward 让无法继续滚动的嵌套控件把滚轮转交给外层视口。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" Focusable="False"
                FocusVisualStyle="{x:Null}" win:ScrollViewerWheel.Forward="True">
    <!-- 账号页在效果图里是整宽单列：卡片一张压一张，只有未登录的那个表单保留左右并排 -->
    <StackPanel MaxWidth="1440" Margin="{StaticResource PagePadding}" HorizontalAlignment="Center">
      <StackPanel Margin="0,0,0,14">
        <TextBlock x:Name="Headline" Text="账号" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageSub}" Text="登录后额度、单词本与复习进度跟随账号。"/>
      </StackPanel>

      <!-- v185：安装后的第一次进入会停在登录墙，这是用户看到的第一句说明 -->
      <Border x:Name="LoginRequiredBanner" Background="{DynamicResource BrandFillBrush}"
              CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
        <TextBlock Text="登录后才能使用翻译与其他页面。没有账号可以直接注册，免费额度登录即到账。"
                   FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextBrush}"/>
      </Border>

      <local:CardBoard Columns="1">
        <!-- ================= 未登录（与登录弹窗共用 AuthPanel，保留给 QA 探针） ================= -->
        <local:AuthPanel x:Name="SignedOutPanel" Margin="0,0,0,16"/>

        <!-- ================= 已登录 ================= -->
        <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">

          <!-- 身份区：头像、名字、地址、套餐徽标，以及唯一一个破坏性操作 -->
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center"
                      Background="{DynamicResource BrandFillBrush}">
                <TextBlock x:Name="AvatarText" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                  <Border x:Name="PlanBadge" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="9"
                          Background="{DynamicResource BrandFillBrush}" Padding="7,2">
                    <TextBlock x:Name="PlanBadgeText" FontSize="11"
                               Foreground="{DynamicResource BrandTextBrush}"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="EmailText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
              </StackPanel>

              <Button x:Name="SignOutButton" Grid.Column="2" Content="退出登录" Margin="0"
                      VerticalAlignment="Center" Click="SignOut_Click"/>
            </Grid>
          </Border>

          <!-- 套餐摘要：名称、有效期、剩余量。购买在套餐页 -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="当前套餐" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="PlanNameText" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock x:Name="PlanValidityText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

              <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0"
                      Margin="0,12,0,10"/>

              <StackPanel x:Name="MonthlyRow" Visibility="Collapsed">
                <TextBlock Text="本月剩余" Style="{StaticResource FieldLabelTight}"/>
                <TextBlock x:Name="MonthlyLeftText" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ProgressBar x:Name="MonthlyBar" Style="{StaticResource MeterBar}"/>
              </StackPanel>

              <StackPanel x:Name="DailyRow" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="今日剩余" Style="{StaticResource FieldLabelTight}"/>
                <TextBlock x:Name="DailyLeftText" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ProgressBar x:Name="DailyBar" Style="{StaticResource MeterBar}"/>
              </StackPanel>

              <TextBlock x:Name="UsageStatus" Style="{StaticResource Hint}" Margin="0"
                         AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
              <!-- v208：高 DPI 下卡片内层可能少分到一个物理像素，给按钮描边和键盘焦点环留出底部空间。 -->
              <WrapPanel Margin="0,12,0,4">
                <Button x:Name="UsageRefreshButton" Content="刷新用量" MinWidth="82"
                        Style="{StaticResource SmallButton}" Click="RefreshUsage_Click"/>
                <Button x:Name="GotoPlanButton" Content="看套餐与价格" Margin="0"
                        Style="{StaticResource SmallButton}" Click="GotoPlan_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="登录设备" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="DeviceCountText" Grid.Column="1" Style="{StaticResource Hint}"
                           Margin="0" VerticalAlignment="Center"/>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新设备" Style="{StaticResource SmallButton}"
                        Margin="12,0,0,4" Click="Refresh_Click"/>
              </Grid>
              <TextBlock x:Name="DeviceLimitHint" Style="{StaticResource Hint}" Margin="0,0,0,4"
                         Text="换新电脑前，先移除不用的设备，把名额空出来。"/>

              <ItemsControl x:Name="DeviceItems">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0"
                            Padding="0,9">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Background="{DynamicResource BrandFillBrush}" CornerRadius="4"
                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CurrentBadgeVisibility}">
                              <TextBlock Text="当前" FontSize="10"
                                         Foreground="{DynamicResource BrandTextBrush}"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding DetailLine}" Style="{StaticResource Hint}"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="移除" Tag="{Binding Id}"
                                Style="{StaticResource SmallButton}" Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding RemoveVisibility}"
                                Click="RemoveDevice_Click"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="DeviceEmptyText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                         Text="设备列表读取中…"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="修改名称" Style="{StaticResource CardTitle}"/>
              <TextBox x:Name="NameBox" AutomationProperties.Name="名称" MaxLength="24"
                       TextChanged="Input_Changed"/>
              <TextBlock Text="最多 24 个字。留空就用邮箱当地址显示。" Style="{StaticResource Hint}"/>
              <Button x:Name="SaveNameButton" Content="保存名称" HorizontalAlignment="Left"
                      Style="{StaticResource SmallButton}" Margin="0,10,0,0" Click="SaveName_Click"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="修改密码" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="当前密码" Style="{StaticResource FieldLabelTight}"/>
              <PasswordBox x:Name="CurrentPasswordBox" AutomationProperties.Name="当前密码"/>

              <TextBlock Text="新密码" Style="{StaticResource FieldLabelTight}" Margin="0,12,0,6"/>
              <PasswordBox x:Name="NewPasswordBox" AutomationProperties.Name="新密码"/>

              <TextBlock Text="再输一次" Style="{StaticResource FieldLabelTight}" Margin="0,12,0,6"/>
              <PasswordBox x:Name="ConfirmPasswordBox" AutomationProperties.Name="确认新密码"/>

              <TextBlock Text="至少 8 位。改完之后其他设备要重新登录，这台不用。"
                         Style="{StaticResource Hint}"/>
              <Button x:Name="SavePasswordButton" Content="保存密码" HorizontalAlignment="Left"
                      Style="{StaticResource SmallButton}" Margin="0,10,0,0" Click="SavePassword_Click"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="隐私与数据" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="单词本、复习进度都存在服务端，退出登录不会删掉，换机器登录同一个账号就能拿回来。"
                         Style="{StaticResource Hint}" Margin="0"/>

              <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0"
                      Margin="0,12,0,10"/>

              <TextBlock Text="注销账号会永久删除账号和全部学习记录，无法恢复。"
                         Style="{StaticResource Hint}" Margin="0"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="DeleteAccountButton" Content="注销账号" Style="{StaticResource SmallButton}"
                        Foreground="{DynamicResource DangerBrush}" Click="DeleteAccount_Click"/>
              </StackPanel>

              <StackPanel x:Name="DeletePanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="当前密码" Style="{StaticResource FieldLabelTight}"/>
                <PasswordBox x:Name="DeletePasswordBox" AutomationProperties.Name="注销账号密码"/>
                <TextBlock Text="输入账号邮箱确认" Style="{StaticResource FieldLabelTight}" Margin="0,10,0,6"/>
                <TextBox x:Name="DeleteConfirmBox" AutomationProperties.Name="确认邮箱"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="ConfirmDeleteButton" Content="确认注销" Style="{StaticResource SmallButton}"
                          Foreground="{DynamicResource DangerBrush}" Click="ConfirmDelete_Click"/>
                  <Button x:Name="CancelDeleteButton" Content="取消" Style="{StaticResource SmallButton}"
                          Margin="8,0,0,0" Click="CancelDelete_Click"/>
                </StackPanel>
                <TextBlock Text="删掉后只能用同一邮箱重新注册一个全新账号。"
                           Style="{StaticResource Hint}" Margin="0,8,0,0"/>
              </StackPanel>

              <Button x:Name="SupportButton" Content="联系支持" HorizontalAlignment="Left"
                      Style="{StaticResource FlatLinkButton}" Margin="0,10,0,0" Click="Support_Click"/>
              <TextBlock x:Name="SupportEmailText" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="2,0,2,0"/>
        </StackPanel>
      </local:CardBoard>
    </StackPanel>
  </ScrollViewer>
</UserControl>

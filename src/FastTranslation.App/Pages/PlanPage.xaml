<UserControl x:Class="FastTranslation.App.Pages.PlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="MeterBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="3" HorizontalAlignment="Left"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- v92：效果图 A 的 facts 小卡与「额度怎么重置」行——13px 标题、12px 说明，
         行是左键右值，靠列宽把值推到右边，不用手写对齐空格。 -->
    <Style x:Key="FactTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="FactBody" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="RuleRow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="0,10"/>
    </Style>
    <Style x:Key="RuleKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="RuleValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="24,0,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" Focusable="False">
    <StackPanel MaxWidth="1440" Margin="28,22,28,26" HorizontalAlignment="Center">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="Headline" Style="{StaticResource PageTitle}" Text="套餐"/>
          <TextBlock Style="{StaticResource PageSub}" Text="订阅后解锁单词本与四档复习，额度按月计算。"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource TopPill}" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="当前" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,5,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="PlanPillText" Text="免费版" FontSize="12.5" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource BrandTextBrush}"/>
          </StackPanel>
        </Border>
      </Grid>
      <!-- v91：hero 按效果图重做——左边是「当前套餐」大字，右边是 118px 用量环。
           42px 的套餐名是整页的视觉锚点，原来的 13px 标题做不到这一点。
           v99：外层不写 ClipToBounds——矩形裁剪发生在 Effect 之后，会把投影切得只剩四角三角
           残影（用户反馈）；裁切交给卡片自己的圆角处理。
           v135：套餐选择从 hero 右列拆出去，单独一栏，避免和用量挤在同一张卡里。 -->
      <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="1.1*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="26,24,24,24" VerticalAlignment="Center">
            <Border Background="{DynamicResource BrandFillBrush}" CornerRadius="6" Padding="8,3"
                    HorizontalAlignment="Left">
              <TextBlock Text="当前套餐" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrandTextBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock x:Name="PlanNameText" Text="免费版" FontSize="42" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock x:Name="PlanTermText" Text="长期有效" FontSize="14" Margin="10,0,0,8"
                         VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Text="付费档都包含" FontSize="10.5" Margin="0,16,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Border Background="{DynamicResource BrandFillBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                <TextBlock Text="单词本" FontSize="10.5" Foreground="{DynamicResource BrandTextBrush}"/>
              </Border>
              <Border Background="{DynamicResource BrandFillBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                <TextBlock Text="四档复习" FontSize="10.5" Foreground="{DynamicResource BrandTextBrush}"/>
              </Border>
              <Border Background="{DynamicResource BrandFillBrush}" CornerRadius="5" Padding="7,2">
                <TextBlock Text="跨设备同步" FontSize="10.5" Foreground="{DynamicResource BrandTextBrush}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="额度用完自动回落自带 Key，翻译不中断。" FontSize="11.5" Margin="0,10,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="24,24,28,24" VerticalAlignment="Center">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 用量环：WPF 没有 conic-gradient，环由一条 12px 描边、带圆头的圆弧路径画出来，
                   弧长按本月已用比例在代码里算（PlanPage.UpdateRing）。 -->
              <Grid Width="118" Height="118" VerticalAlignment="Center">
                <Ellipse Width="106" Height="106" Stroke="{DynamicResource HairBrush}"
                         StrokeThickness="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path x:Name="RingProgress" Stroke="{DynamicResource BrandBrush}" StrokeThickness="12"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock x:Name="RingPercent" Text="0%" FontSize="19" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="本月已用" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="MonthlyLeftText" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="MonthlyText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ProgressBar x:Name="MonthlyBar" Style="{StaticResource MeterBar}"
                             ValueChanged="MonthlyBar_ValueChanged"/>

                <StackPanel x:Name="DailyRow" Margin="0,12,0,0">
                  <TextBlock x:Name="DailyText" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ProgressBar x:Name="DailyBar" Style="{StaticResource MeterBar}"/>
                  <TextBlock x:Name="DailyLeftText" FontSize="12" Margin="0,4,0,0"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <Button Content="刷新用量" Height="34" Margin="0,14,0,0" Padding="16,0"
                        HorizontalAlignment="Left" Click="Refresh_Click"/>

                <TextBlock x:Name="UsageError" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="SignedOutHint" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="登录后才能看到自己的用量，去「账号」页登录。"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- v135：套餐选择单独一栏。
           v136：卡片重做层级。
           v137：状态卡补权益、推荐语补用量。
           v140：档位卡改成「大价格 + 权益清单」，周期切换收进右上角分段控件，按参考图把
           「能做什么」逐条列出。
           v141：停售年付，改卖季付（90 天）；季付就是 3 倍月价，不额外打折。
           卡片上的「6.9 / 5.6 / 4.5 折」是相对「88 万字符 10 元」的标价折算，划线价是
           3 个月的标价（30 / 64.1 / 132.3）。价格与额度是静态文案，改价时这里、site 和
           server/FastTranslation.Server/Orders/OrderPricing.cs 要同批改。 -->
      <Border Style="{StaticResource Card}" Padding="24,20,24,18" Margin="0,0,0,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="SubscribeTitle" Text="选择套餐与周期" FontSize="15" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="三档功能相同，按每月用量选；标价按 88 万字符 10 元折算，季付一次付 90 天。" FontSize="11.5" Margin="0,3,0,0"
                         Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource WindowBgBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" Padding="3"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="MonthlyCycleCard" Tag="monthly" BorderThickness="1" CornerRadius="8"
                        BorderBrush="{DynamicResource BrandBrush}" Background="{DynamicResource BrandFillBrush}"
                        Padding="14,7" Cursor="Hand" MouseLeftButtonUp="Cycle_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="月付" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="30 天" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </Border>
                <Border x:Name="QuarterlyCycleCard" Tag="quarterly" BorderThickness="1" CornerRadius="8"
                        BorderBrush="{DynamicResource HairBrush}" Background="Transparent"
                        Padding="14,7" Margin="4,0,0,0" Cursor="Hand" MouseLeftButtonUp="Cycle_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="季付" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="90 天" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LiteCard" Tag="light" BorderThickness="1" CornerRadius="14"
                    BorderBrush="{DynamicResource HairBrush}" Background="Transparent"
                    Padding="18,16" Cursor="Hand" MouseLeftButtonUp="Tier_Click">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Lite" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                  <TextBlock Text="¥6.9" FontSize="34" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="/月" FontSize="12" VerticalAlignment="Bottom" Margin="3,0,0,5"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,3,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="季付 ¥20.7 · 标价 "/>
                    <Run Text="¥30" TextDecorations="Strikethrough"/>
                  </TextBlock>
                  <Border Grid.Column="1" Background="{DynamicResource BrandFillBrush}" CornerRadius="4"
                          BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1" Padding="5,0"
                          Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="6.9 折" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandTextBrush}"/>
                  </Border>
                </Grid>

                <Border Grid.Row="3" Height="1" Background="{DynamicResource HairBrush}" Margin="0,14,0,0"/>

                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="88 万字符 / 月" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="单词本 + 四档复习" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="划词 / 截图 / 文档翻译" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="语音约 5 小时" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="ProCard" Tag="standard" Grid.Column="2" BorderThickness="1.5" CornerRadius="14"
                    BorderBrush="{DynamicResource BrandBrush}" Background="{DynamicResource BrandFillBrush}"
                    Padding="18,16" Cursor="Hand" MouseLeftButtonUp="Tier_Click">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Pro" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource BrandBrush}" CornerRadius="5"
                          Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="推荐" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnBrandTextBrush}"/>
                  </Border>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                  <TextBlock Text="¥11.9" FontSize="34" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="/月" FontSize="12" VerticalAlignment="Bottom" Margin="3,0,0,5"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,3,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="季付 ¥35.7 · 标价 "/>
                    <Run Text="¥64.1" TextDecorations="Strikethrough"/>
                  </TextBlock>
                  <Border Grid.Column="1" Background="{DynamicResource BrandFillBrush}" CornerRadius="4"
                          BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1" Padding="5,0"
                          Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="5.6 折" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandTextBrush}"/>
                  </Border>
                </Grid>

                <Border Grid.Row="3" Height="1" Background="{DynamicResource HairBrush}" Margin="0,14,0,0"/>

                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="188 万字符 / 月（约 2 倍 Lite）" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="包含 Lite 全部权益" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="更多截图翻译" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="语音约 10 小时" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="MaxCard" Tag="max" Grid.Column="4" BorderThickness="1" CornerRadius="14"
                    BorderBrush="{DynamicResource HairBrush}" Background="Transparent"
                    Padding="18,16" Cursor="Hand" MouseLeftButtonUp="Tier_Click">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Max" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                  <TextBlock Text="¥19.9" FontSize="34" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="/月" FontSize="12" VerticalAlignment="Bottom" Margin="3,0,0,5"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,3,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="季付 ¥59.7 · 标价 "/>
                    <Run Text="¥132.3" TextDecorations="Strikethrough"/>
                  </TextBlock>
                  <Border Grid.Column="1" Background="{DynamicResource BrandFillBrush}" CornerRadius="4"
                          BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1" Padding="5,0"
                          Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="4.5 折" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandTextBrush}"/>
                  </Border>
                </Grid>

                <Border Grid.Row="3" Height="1" Background="{DynamicResource HairBrush}" Margin="0,14,0,0"/>

                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="388 万字符 / 月（约 4 倍 Lite）" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="包含 Pro 全部权益" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="批量文档更从容" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="语音约 21 小时" FontSize="12" Margin="9,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="微信 / 支付宝收款，到账后自动开通。" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <Button x:Name="SubscribeButton" Grid.Column="1" Content="订阅" Width="240" Height="44"
                    Style="{StaticResource PrimaryButton}" Click="Subscribe_Click"/>
          </Grid>

          <TextBlock x:Name="SubscribeHint" FontSize="11.5" Margin="0,9,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Text="登录后点订阅，会创建订单并显示收款码。"/>
        </StackPanel>
      </Border>
      <!-- v92：按效果图 A 的阅读顺序——先三张 facts 小卡并排，再让「激活码」和
           「额度怎么重置」各自独占一行。原来的三列要点挤在一张卡里用圆点列举，
           下面两张卡又被 CardBoard 拆成左右两半，读起来比效果图碎。 -->
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="16,15,18,16">
          <StackPanel>
            <TextBlock Text="单词本" Style="{StaticResource FactTitle}"/>
            <TextBlock Text="单词、短语、整句都能存,按分栏翻。" Style="{StaticResource FactBody}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16,15,18,16" Grid.Column="2">
          <StackPanel>
            <TextBlock Text="四档复习" Style="{StaticResource FactTitle}"/>
            <TextBlock Text="忘记 / 模糊 / 熟悉 / 记住,按自己的感觉排下一次。" Style="{StaticResource FactBody}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16,15,18,16" Grid.Column="4">
          <StackPanel>
            <TextBlock Text="额度" Style="{StaticResource FactTitle}"/>
            <TextBlock Text="付费档每月 88 万 / 188 万 / 388 万字符,不再受每日上限限制。" Style="{StaticResource FactBody}"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,15,18,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="激活码" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="RedeemBox" Width="240" AutomationProperties.Name="激活码" MaxLength="24"
                       TextChanged="Input_Changed"/>
              <Button x:Name="RedeemButton" Content="兑换" Margin="10,0,0,0"
                      Style="{StaticResource SmallButton}" Click="Redeem_Click"/>
            </StackPanel>
          </Grid>
          <!-- 这行既是说明也是兑换结果与报错的出口，所以留在按钮下面通栏，
               不跟标题挤在左边，出错时用户第一眼能看到。 -->
          <TextBlock x:Name="RedeemHint" Style="{StaticResource Hint}" Margin="0,10,0,0"
                     Text="买到激活码后填在这里,兑换后套餐立刻生效。"/>
        </StackPanel>
      </Border>

      <!-- 重置规则属于套餐，所以放在它所解释的计量旁边 -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="额度怎么重置" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
          <Border Style="{StaticResource RuleRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="本月额度" Style="{StaticResource RuleKey}"/>
              <TextBlock Grid.Column="1" Text="从账号开通那天起每满一个自然月归零;续费不改变日期(例:11 月 12 日开通,12 月 12 日 8:00 归零)。" Style="{StaticResource RuleValue}"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource RuleRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="今日额度" Style="{StaticResource RuleKey}"/>
              <TextBlock Grid.Column="1" Text="北京时间每天 8:00 归零;免费版每台设备每天 2,000 字符。" Style="{StaticResource RuleValue}"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource RuleRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="复习队列" Style="{StaticResource RuleKey}"/>
              <TextBlock Grid.Column="1" Text="按本机时间每天 0:00 换新的一天:到期卡全部排进来,另加最多 20 条当天新存的。" Style="{StaticResource RuleValue}"/>
            </Grid>
          </Border>
          <TextBlock Text="额度按 UTC 日历算、不跟随本机时区,换电脑不会多算一天;复习队列按本机零点。"
                     Style="{StaticResource Hint}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

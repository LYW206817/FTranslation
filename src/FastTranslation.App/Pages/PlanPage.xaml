<UserControl x:Class="FastTranslation.App.Pages.PlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12,14,14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="FieldLabelTight" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="MeterBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="3" HorizontalAlignment="Left"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Focusable="False">
    <Grid MaxWidth="980" Margin="24,18,24,26">
      <StackPanel>
        <TextBlock x:Name="Headline" Text="套餐" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- left: what it costs -->
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="SubscribeTitle" Text="订阅后解锁单词本与四档复习"
                           Style="{StaticResource CardTitle}"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- yearly is the default: lower unit price, and people who land here want a year -->
                  <Border x:Name="YearCard" Grid.Column="0" BorderThickness="1.5" CornerRadius="8"
                          BorderBrush="{DynamicResource BrandBrush}"
                          Background="{DynamicResource BrandFillBrush}"
                          Padding="12,10" Cursor="Hand" MouseLeftButtonUp="Year_Click">
                    <StackPanel>
                      <TextBlock Text="年付" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="¥144" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="/年" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                      </StackPanel>
                      <TextBlock Text="约 ¥12/月 · 省 33%" FontSize="11" Margin="0,2,0,0"
                                 Foreground="{DynamicResource BrandBrush}"/>
                    </StackPanel>
                  </Border>

                  <Border x:Name="MonthCard" Grid.Column="2" BorderThickness="1" CornerRadius="8"
                          BorderBrush="{DynamicResource HairBrush}" Background="Transparent"
                          Padding="12,10" Cursor="Hand" MouseLeftButtonUp="Month_Click">
                    <StackPanel>
                      <TextBlock Text="月付" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="¥18" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="/月" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                      </StackPanel>
                      <TextBlock Text="随时取消" FontSize="11" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <Button x:Name="SubscribeButton" Content="订阅" Height="34" Margin="0,12,0,0"
                        Style="{StaticResource PrimaryButton}" Click="Subscribe_Click"/>
                <TextBlock x:Name="SubscribeHint" Style="{StaticResource Hint}"
                           Text="付款渠道尚未接通,当前版本点击后仅记录意向。"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="包括什么" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="· 单词本:单词、短语、整句都能存,按分栏翻。"
                           Style="{StaticResource Hint}" Margin="0"/>
                <TextBlock Text="· 四档复习:忘记 / 模糊 / 熟悉 / 记住,按自己的感觉排下一次。"
                           Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                <TextBlock Text="· 额度:标准版每月 300 万字符,不再受每日上限限制。"
                           Style="{StaticResource Hint}" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="激活码" Style="{StaticResource CardTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="RedeemBox" AutomationProperties.Name="激活码" MaxLength="24"
                           TextChanged="Input_Changed"/>
                  <Button x:Name="RedeemButton" Grid.Column="1" Content="兑换" Margin="8,0,0,0"
                          Style="{StaticResource SmallButton}" Click="Redeem_Click"/>
                </Grid>
                <TextBlock x:Name="RedeemHint" Style="{StaticResource Hint}"
                           Text="买到激活码后填在这里,兑换后套餐立刻生效。"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- right: what is left, and when it comes back -->
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="用量" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="本月" Style="{StaticResource FieldLabelTight}"/>
                <TextBlock x:Name="MonthlyText" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ProgressBar x:Name="MonthlyBar" Style="{StaticResource MeterBar}"/>
                <TextBlock x:Name="MonthlyLeftText" Style="{StaticResource Hint}"/>

                <StackPanel x:Name="DailyRow" Margin="0,14,0,0">
                  <TextBlock Text="今日" Style="{StaticResource FieldLabelTight}"/>
                  <TextBlock x:Name="DailyText" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <ProgressBar x:Name="DailyBar" Style="{StaticResource MeterBar}"/>
                  <TextBlock x:Name="DailyLeftText" Style="{StaticResource Hint}"/>
                </StackPanel>

                <TextBlock x:Name="UsageError" Style="{StaticResource Hint}"
                           Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="SignedOutHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                           Text="登录后才能看到自己的用量,去「账号」页登录。"/>
              </StackPanel>
            </Border>

            <!-- resets belong to the plan, so the rules sit next to the meters they explain -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="额度怎么重置" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="本月额度" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="北京时间每月 1 日 8:00 归零,重新按整月计算。"
                           Style="{StaticResource Hint}" Margin="0,3,0,0"/>

                <TextBlock Text="今日额度" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="北京时间每天 8:00 归零。免费版每天 2,000 字符,标准版没有每日上限。"
                           Style="{StaticResource Hint}" Margin="0,3,0,0"/>

                <TextBlock Text="复习队列" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="同样在北京时间 8:00 换新的一天:到期卡全部排进来,另外最多再加 20 条当天新存的。"
                           Style="{StaticResource Hint}" Margin="0,3,0,0"/>

                <TextBlock Text="把日历放在 UTC 上是刻意的:服务端不跟着用户机器的时区走,换一台电脑不会多算一天。"
                           Style="{StaticResource Hint}" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>

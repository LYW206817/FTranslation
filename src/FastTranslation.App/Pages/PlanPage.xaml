<UserControl x:Class="FastTranslation.App.Pages.PlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="MeterBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="3" HorizontalAlignment="Left"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" Focusable="False">
    <StackPanel MaxWidth="1440" Margin="28,22,28,26" HorizontalAlignment="Center">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="Headline" Style="{StaticResource PageTitle}" Text="套餐"/>
          <TextBlock Style="{StaticResource PageSub}" Text="订阅后解锁单词本与四档复习，额度按月计算。"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource TopPill}" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="当前" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,5,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="PlanPillText" Text="免费版" FontSize="12.5" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource BrandTextBrush}"/>
          </StackPanel>
        </Border>
      </Grid>
      <!-- v91：hero 按效果图重做——左边是「当前套餐」大字 + 118px 用量环，右边是价格与入口，
           右列带一层冷暖薄渐变和一道发丝线把它和左边分开。42px 的套餐名是整页的视觉锚点，
           原来的 13px 标题做不到这一点。 -->
      <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.12*"/>
            <ColumnDefinition Width="0.88*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="26,24,28,24">
            <Border Background="{DynamicResource BrandFillBrush}" CornerRadius="6" Padding="8,3"
                    HorizontalAlignment="Left">
              <TextBlock Text="当前套餐" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrandTextBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock x:Name="PlanNameText" Text="免费版" FontSize="42" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock x:Name="PlanTermText" Text="长期有效" FontSize="14" Margin="10,0,0,8"
                         VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 用量环：WPF 没有 conic-gradient，环由一条 12px 描边、带圆头的圆弧路径画出来，
                   弧长按本月已用比例在代码里算（PlanPage.UpdateRing）。 -->
              <Grid Width="118" Height="118" VerticalAlignment="Center">
                <Ellipse Width="106" Height="106" Stroke="{DynamicResource HairBrush}"
                         StrokeThickness="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path x:Name="RingProgress" Stroke="{DynamicResource BrandBrush}" StrokeThickness="12"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock x:Name="RingPercent" Text="0%" FontSize="19" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="本月已用" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="MonthlyLeftText" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="MonthlyText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ProgressBar x:Name="MonthlyBar" Style="{StaticResource MeterBar}"
                             ValueChanged="MonthlyBar_ValueChanged"/>

                <StackPanel x:Name="DailyRow" Margin="0,12,0,0">
                  <TextBlock x:Name="DailyText" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ProgressBar x:Name="DailyBar" Style="{StaticResource MeterBar}"/>
                  <TextBlock x:Name="DailyLeftText" FontSize="12" Margin="0,4,0,0"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <Button Content="刷新用量" Height="34" Margin="0,14,0,0" Padding="16,0"
                        HorizontalAlignment="Left" Click="Refresh_Click"/>

                <TextBlock x:Name="UsageError" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="SignedOutHint" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="登录后才能看到自己的用量，去「账号」页登录。"/>
              </StackPanel>
            </Grid>
          </StackPanel>

          <Border Grid.Column="1" Background="{DynamicResource HeroPanelBrush}"
                  BorderBrush="{DynamicResource HairBrush}" BorderThickness="1,0,0,0"
                  Padding="26,24,28,24">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SubscribeTitle" Text="订阅后解锁单词本与四档复习"
                         FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 默认选年付：单价更低，而且点进来的人多半就是想买一年 -->
                <Border x:Name="YearCard" Grid.Column="0" BorderThickness="1.5" CornerRadius="10"
                        BorderBrush="{DynamicResource BrandBrush}"
                        Background="{DynamicResource BrandFillBrush}"
                        Padding="12,10" Cursor="Hand" MouseLeftButtonUp="Year_Click">
                  <StackPanel>
                    <TextBlock Text="年付" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Text="¥144" FontSize="19" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="/年" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <TextBlock Text="约 ¥12/月 · 省 33%" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource BrandTextBrush}"/>
                  </StackPanel>
                </Border>

                <Border x:Name="MonthCard" Grid.Column="2" BorderThickness="1" CornerRadius="10"
                        BorderBrush="{DynamicResource HairBrush}" Background="Transparent"
                        Padding="12,10" Cursor="Hand" MouseLeftButtonUp="Month_Click">
                  <StackPanel>
                    <TextBlock Text="月付" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Text="¥18" FontSize="19" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="/月" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <TextBlock Text="随时取消" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Button x:Name="SubscribeButton" Content="订阅" Height="40" Margin="0,14,0,0"
                      Style="{StaticResource PrimaryButton}" Click="Subscribe_Click"/>
              <TextBlock x:Name="SubscribeHint" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Text="付款渠道尚未接通，当前版本点击后仅记录意向。"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="包括什么" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="· 单词本:单词、短语、整句都能存,按分栏翻。"
                     Style="{StaticResource Hint}" Margin="0"/>
          <TextBlock Text="· 四档复习:忘记 / 模糊 / 熟悉 / 记住,按自己的感觉排下一次。"
                     Style="{StaticResource Hint}" Margin="0,7,0,0"/>
          <TextBlock Text="· 额度:标准版每月 300 万字符,不再受每日上限限制。"
                     Style="{StaticResource Hint}" Margin="0,7,0,0"/>
        </StackPanel>
      </Border>

      <local:CardBoard Columns="2" Margin="0,16,0,0">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="激活码" Style="{StaticResource CardTitle}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="RedeemBox" AutomationProperties.Name="激活码" MaxLength="24"
                       TextChanged="Input_Changed"/>
              <Button x:Name="RedeemButton" Grid.Column="1" Content="兑换" Margin="8,0,0,0"
                      Style="{StaticResource SmallButton}" Click="Redeem_Click"/>
            </Grid>
            <TextBlock x:Name="RedeemHint" Style="{StaticResource Hint}"
                       Text="买到激活码后填在这里,兑换后套餐立刻生效。"/>
          </StackPanel>
        </Border>

        <!-- 重置规则属于套餐，所以放在它所解释的计量旁边 -->
        <Border Style="{StaticResource Card}" local:CardBoard.Column="1">
          <StackPanel>
            <TextBlock Text="额度怎么重置" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="本月额度" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="北京时间每月 1 日 8:00 归零,重新按整月计算。"
                       Style="{StaticResource Hint}" Margin="0,3,0,0"/>

            <TextBlock Text="今日额度" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="北京时间每天 8:00 归零。免费版每天 2,000 字符,标准版没有每日上限。"
                       Style="{StaticResource Hint}" Margin="0,3,0,0"/>

            <TextBlock Text="复习队列" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="同样在北京时间 8:00 换新的一天:到期卡全部排进来,另外最多再加 20 条当天新存的。"
                       Style="{StaticResource Hint}" Margin="0,3,0,0"/>

            <TextBlock Text="把日历放在 UTC 上是刻意的:服务端不跟着用户机器的时区走,换一台电脑不会多算一天。"
                       Style="{StaticResource Hint}" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </local:CardBoard>
    </StackPanel>
  </ScrollViewer>
</UserControl>

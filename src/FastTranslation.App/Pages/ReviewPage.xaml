<UserControl x:Class="FastTranslation.App.Pages.ReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
             Focusable="True">
  <UserControl.Resources>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 选题列表的一行：一个复选框、种类标签，然后是保存的内容 -->
    <Style x:Key="PickRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding SourceText}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PickList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource PickRow}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="Auto">
              <ItemsPresenter/>
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 练习中的四档评分：悬停前安静，揭晓前置灰 -->
    <Style x:Key="GradeButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandFillBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NextLabel" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="Headline" Text="复习" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock x:Name="CountLabel" Margin="10,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,2"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <!-- ===== 模式 1：今天等什么，勾选想练的 ===== -->
      <Grid x:Name="PickHost">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <Button x:Name="StartButton" DockPanel.Dock="Right" Content="开始复习" Padding="20,6"
                  Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Start_Click"/>
          <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Padding="14,5"
                  Margin="0,0,8,0" Click="Refresh_Click"/>
          <CheckBox x:Name="SelectAll" Content="全选" VerticalAlignment="Center" Margin="0,0,14,0"
                    IsChecked="True" Click="SelectAll_Click"/>
          <TextBlock x:Name="PickHint" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <TextBlock Text=" "/>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" Padding="6,8,6,6">
          <Grid>
            <ListBox x:Name="PickList" Style="{StaticResource PickList}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              VerticalAlignment="Top" Margin="0,1,12,0"
                              Checked="Pick_Checked" Unchecked="Pick_Checked"/>

                    <StackPanel Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource BrandFillBrush}" CornerRadius="4"
                                Padding="5,1" VerticalAlignment="Center" Margin="0,0,8,0">
                          <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                     Foreground="{DynamicResource BrandBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource HairBrush}" CornerRadius="4"
                                Padding="5,1" VerticalAlignment="Center" Margin="0,0,8,0"
                                Visibility="{Binding NewBadgeVisibility}">
                          <TextBlock Text="新" FontSize="10"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding SourceText}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Text="{Binding TargetText}" FontSize="12" Margin="0,4,0,0"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock Text="{Binding MetaLine}" FontSize="11" Margin="0,3,0,0"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="PickEmpty" Visibility="Collapsed" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" MaxWidth="320"
                       TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== 模式 2：一次一张卡，就在本页里 ===== -->
      <Grid x:Name="SessionHost" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <Button x:Name="EndButton" DockPanel.Dock="Right" Content="结束复习" Padding="14,5"
                  Click="End_Click"/>
          <Button x:Name="SkipButton" DockPanel.Dock="Right" Content="跳过" Padding="14,5"
                  Margin="0,0,8,0" Click="Skip_Click"/>
          <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" VerticalAlignment="Center"
                     Margin="0,0,14,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
          <TextBlock x:Name="SessionHint" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="空格 看译文 · 1 忘记 · 2 模糊 · 3 熟悉 · 4 记住 · 跳过不算评过"/>
          <TextBlock Text=" "/>
        </DockPanel>

        <!-- 卡片：上面是被考的内容，下面是答案槽。这个槽必须落在文字
             下方而不是盖在文字上：横在中间的一块遮罩会把单词挡住。 -->
        <StackPanel x:Name="CardHost" Grid.Row="1" VerticalAlignment="Center">
          <TextBlock x:Name="PromptText" FontSize="21" LineHeight="34" Margin="24,0"
                     TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>

          <Grid x:Name="RevealSlot" Margin="0,22,0,0" MaxWidth="560" HorizontalAlignment="Center">
            <Grid x:Name="RevealMask" Background="Transparent" Cursor="Hand" MaxWidth="460"
                  MouseLeftButtonUp="Reveal_Click">
              <Rectangle RadiusX="10" RadiusY="10" Fill="Transparent"
                         Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                         StrokeDashArray="3 2"/>
              <StackPanel Margin="30,18" VerticalAlignment="Center">
                <TextBlock Text="点击看译文" FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="按空格也一样" FontSize="11" Margin="0,6,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
              </StackPanel>
            </Grid>

            <ScrollViewer x:Name="AnswerPanel" Visibility="Collapsed" MaxHeight="260"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Height="1" Background="{DynamicResource HairBrush}" Width="120"
                        HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock x:Name="AnswerText" FontSize="17" LineHeight="28" TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="OriginText" FontSize="11" Margin="0,14,0,0" TextAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="AnnotationText" FontSize="12" Margin="0,8,0,0" TextAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextAlignment="Center" FontSize="12"
                     TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                     Visibility="Collapsed"/>
        </StackPanel>

        <!-- 四档评分；答案可见之前置灰。故意设 Focusable="False"：
             键盘路径是 1/2/3/4，若按钮可获得焦点，它既会抢走 Space（用来揭晓答案），
             又会在鼠标点过之后留下一圈焦点框。 -->
        <Border x:Name="GradeBar" Grid.Row="2" BorderBrush="{DynamicResource HairBrush}"
                BorderThickness="0,1,0,0" Padding="0,12,0,4">
          <!-- 故意压窄：四个 320px 宽的按钮读起来像工具栏，而不是四个选项 -->
          <Grid MaxWidth="620">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <Button x:Name="ForgotButton" Focusable="False" Style="{StaticResource GradeButton}"
                      Tag="forgot" Content="忘记" Click="Grade_Click" IsEnabled="False"/>
              <TextBlock x:Name="ForgotNext" Style="{StaticResource NextLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Button x:Name="FuzzyButton" Focusable="False" Style="{StaticResource GradeButton}"
                      Tag="fuzzy" Content="模糊" Click="Grade_Click" IsEnabled="False"/>
              <TextBlock x:Name="FuzzyNext" Style="{StaticResource NextLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <Button x:Name="FamiliarButton" Focusable="False" Style="{StaticResource GradeButton}"
                      Tag="familiar" Content="熟悉" Click="Grade_Click" IsEnabled="False"/>
              <TextBlock x:Name="FamiliarNext" Style="{StaticResource NextLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="6">
              <Button x:Name="KnownButton" Focusable="False" Style="{StaticResource GradeButton}"
                      Tag="known" Content="记住" Click="Grade_Click" IsEnabled="False"/>
              <TextBlock x:Name="KnownNext" Style="{StaticResource NextLabel}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 完成态：这一轮结束了，但页面仍停在原地 -->
        <StackPanel x:Name="DonePanel" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
          <TextBlock x:Name="DoneTitle" FontSize="17" TextAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" Text="这一轮过完了。"/>
          <TextBlock x:Name="DoneText" Style="{StaticResource Hint}" Margin="0,10,0,0"
                     HorizontalAlignment="Center" TextAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="AgainButton" Content="再选一批" Padding="16,6" Click="Again_Click"/>
            <Button x:Name="NotesButton" Content="回单词本" Padding="16,6" Margin="8,0,0,0"
                    Click="Notes_Click"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

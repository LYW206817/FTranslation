<UserControl x:Class="FastTranslation.App.Pages.DocumentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>
    <!-- 与 PlanPage 的同名样式一致；App.xaml 里没有全局版，各页自己带一份 -->
    <Style x:Key="MeterBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="3" HorizontalAlignment="Left"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" Focusable="False">
    <!-- 标题留在 CardBoard 外面：整宽在页顶，卡片那一坨才分列 -->
    <StackPanel MaxWidth="1440" Margin="24,18,24,26" HorizontalAlignment="Center">
      <TextBlock x:Name="Headline" Text="文档翻译" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
      <local:CardBoard Columns="2">
        <!-- 拖放区：整块都是投放目标，虚线只用来示意边界 -->
        <Border x:Name="DropZone" Style="{StaticResource Card}" AllowDrop="True"
                DragOver="DropZone_DragOver" Drop="DropZone_Drop">
          <Grid MinHeight="128">
            <Rectangle RadiusX="10" RadiusY="10" Fill="Transparent"
                       Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                       StrokeDashArray="3 2"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="DropTitle" Text="把 docx / txt / md 拖到这里"
                         FontSize="13" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock x:Name="DropMeta" FontSize="11" Margin="0,6,0,0"
                         HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextMutedBrush}"/>
              <Button x:Name="PickButton" Content="选择文件" Style="{StaticResource PrimaryButton}"
                      HorizontalAlignment="Center" Margin="0,12,0,0" Padding="20,6"
                      Click="Pick_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 未译段清单：黄色在深色主题下不可读，统一用危险色描边当警示 -->
        <Border x:Name="FailedCard" Style="{StaticResource Card}" Visibility="Collapsed"
                BorderBrush="{DynamicResource DangerBrush}">
          <StackPanel>
            <TextBlock x:Name="FailedTitle" Style="{StaticResource CardTitle}" Text="有段没译成"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="这些段落保留原文并标了「【未翻译】」。重试不会重译已经译好的段，所以不会重复计费。"/>
            <ItemsControl x:Name="FailedList" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="8"
                          Padding="10,7" Margin="0,0,0,6">
                    <StackPanel>
                      <TextBlock Text="{Binding Path}" FontSize="10"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                      <TextBlock Text="{Binding Source}" FontSize="12" MaxHeight="42" Margin="0,3,0,0"
                                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="RetryButton" Content="重试未翻译的段"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                    Margin="0,6,0,0" Padding="16,6" Click="Retry_Click"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" local:CardBoard.Column="1">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="翻译成"/>
            <StackPanel Orientation="Horizontal">
              <local:FtComboBox x:Name="TargetCombo" Width="180"
                                SelectionChanged="TargetCombo_SelectionChanged"/>
              <Button x:Name="StartButton" Content="开始翻译" Style="{StaticResource PrimaryButton}"
                      Margin="12,0,0,0" Padding="20,6" IsEnabled="False" Click="Start_Click"/>
              <Button x:Name="CancelButton" Content="取消" Margin="8,0,0,0" Padding="16,6"
                      Visibility="Collapsed" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="QuotaText" Style="{StaticResource Hint}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="文件在本机解析，只有段落文字会发送到翻译接口；原文件不会被修改。"/>
          </StackPanel>
        </Border>

        <Border x:Name="ProgressCard" Style="{StaticResource Card}" Visibility="Collapsed"
                local:CardBoard.Column="1">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="进度"/>
            <TextBlock x:Name="ProgressText" FontSize="12" Text="已完成 0 / 0 段"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ProgressBar x:Name="Progress" Style="{StaticResource MeterBar}"/>
          </StackPanel>
        </Border>

        <Border x:Name="ResultCard" Style="{StaticResource Card}" Visibility="Collapsed"
                local:CardBoard.Column="1">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="翻译完成"/>
            <TextBlock x:Name="ResultText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="OpenFolderButton" Content="打开所在文件夹" Padding="14,6"
                      Click="OpenFolder_Click"/>
              <Button x:Name="AgainButton" Content="再译一份" Padding="14,6" Margin="8,0,0,0"
                      Click="Again_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border x:Name="ErrorCard" Style="{StaticResource Card}" Visibility="Collapsed"
                BorderBrush="{DynamicResource DangerBrush}" local:CardBoard.Column="1">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="没能继续"/>
            <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}"/>
          </StackPanel>
        </Border>
      </local:CardBoard>
    </StackPanel>
  </ScrollViewer>
</UserControl>

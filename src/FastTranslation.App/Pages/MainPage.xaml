<UserControl x:Class="FastTranslation.App.Pages.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             Background="Transparent" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 输入纸张：安静的一张纸，里面没有别的东西 -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" Padding="4">
      <Grid MinHeight="96">
        <TextBox x:Name="InputBox" Background="Transparent" BorderThickness="0"
                 Padding="14,12,14,10" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 TextChanged="InputBox_TextChanged" KeyDown="InputBox_KeyDown"/>
        <TextBlock x:Name="InputHint" IsHitTestVisible="False" FontSize="14"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="15,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Text="输入或粘贴要翻译的文本,Ctrl + Enter 快速翻译"/>
      </Grid>
    </Border>

    <!-- 工具栏浮在桌面上，与纸张保持距离 -->
    <DockPanel Grid.Row="1" Margin="2,12,2,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <local:FtComboBox x:Name="TargetCombo" Width="180"
                          SelectionChanged="TargetCombo_SelectionChanged"/>
        <Border Margin="10,0,0,0" VerticalAlignment="Center"
                Background="{DynamicResource BrandFillBrush}" CornerRadius="9" Padding="10,3">
          <TextBlock x:Name="ModelLabel" FontSize="11" Foreground="{DynamicResource BrandTextBrush}"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CopyResultButton" Content="复制译文" Padding="12,5" Margin="0,0,8,0"
                Click="CopyResult_Click" IsEnabled="False"/>
        <Button x:Name="SaveButton" Content="存到单词本" Padding="12,5" Margin="0,0,8,0"
                Click="Save_Click" IsEnabled="False"/>
        <Button x:Name="TranslateButton" Style="{StaticResource PrimaryButton}"
                Content="翻译" Padding="24,6" Margin="0" Click="Translate_Click"/>
      </StackPanel>
    </DockPanel>

    <!-- 译文：写在桌面上的一段引文 -->
    <ScrollViewer Grid.Row="2" Margin="2,18,2,0" VerticalScrollBarVisibility="Auto">
      <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                   Fill="{DynamicResource BoltRuleBrush}" Margin="0,5,16,5" VerticalAlignment="Stretch"/>
        <TextBlock Grid.Column="1" x:Name="ResultBlock" TextWrapping="Wrap" FontSize="14" LineHeight="26"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="输入或粘贴文本,点击翻译;或在任意应用里划词使用小工具条。"/>
      </Grid>
    </ScrollViewer>

    <!-- 底栏：本页能去到的两个去处 -->
    <DockPanel Grid.Row="3" Margin="2,12,2,0">
      <Button x:Name="KeyButton" Content="配置 Key" DockPanel.Dock="Right" HorizontalAlignment="Right"
              Padding="10,4" FontSize="12" Margin="0" Click="KeyButton_Click"/>
      <Button x:Name="ScreenshotButton" Content="截图翻译" DockPanel.Dock="Right"
              HorizontalAlignment="Right" Padding="10,4" FontSize="12" Margin="0,0,8,0"
              Click="Screenshot_Click"/>
      <TextBlock x:Name="HotkeyHint" DockPanel.Dock="Right" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,12,0"/>
      <TextBlock x:Name="KeyStatus" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
    </DockPanel>
  </Grid>
</UserControl>

<Window x:Class="FastTranslation.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 Fast Translation" Width="470" SizeToContent="Height" Icon="/FastTranslation.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <StackPanel Margin="24,20,24,20">

    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <Image Source="/FastTranslation.ico" Width="34" Height="34" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="欢迎使用 Fast Translation" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21"
               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"
               Text="划词即译:在任意应用里选中文本,点一下弹出的小按钮就能翻译、替换或插入。需要你自己的 Qwen-MT API Key(阿里云 DashScope 控制台获取,sk- 开头)。"/>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource BrandBrush}">
        <TextBlock Text="1" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="输入 Qwen-MT API Key" FontSize="13"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <PasswordBox x:Name="KeyBox" Margin="27,0,0,10"/>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource BrandBrush}">
        <TextBlock Text="2" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="测试连接(可选)" FontSize="13"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid Margin="27,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="TestButton" Grid.Column="0" Content="测试连接" Width="110"
              HorizontalAlignment="Left" Margin="0" Click="Test_Click"/>
      <TextBlock x:Name="TestStatus" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                 TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>

    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
      <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource BrandBrush}">
        <TextBlock Text="3" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="开始使用" FontSize="13"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="27,12,0,0">
      <Button Content="稍后再说" Click="Later_Click"/>
      <Button Content="完成" Style="{StaticResource PrimaryButton}" Margin="0" Click="Done_Click"/>
    </StackPanel>
  </StackPanel>
</Window>

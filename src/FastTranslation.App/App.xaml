<Application x:Class="FastTranslation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Light">
  <Application.Resources>

    <!-- ===== FastTranslation 设计 token（品牌：图标奶油蓝 + #2562FF）=====
         这里每个画刷引用都用 DynamicResource 而不是 StaticResource：ThemeBridge.Apply 在启动时
         给它们重新上色，而 StaticResource 只在解析时查一次——第一次做深色模式的尝试里，
         所有界面都还是浅色，原因正是这个。po:Freeze="False" 还让画刷保持可变，
         否则根本没法就地换色。 -->
    <SolidColorBrush x:Key="BrandBrush" po:Freeze="False" Color="#2562FF"/>
    <SolidColorBrush x:Key="BrandHoverBrush" po:Freeze="False" Color="#1D4FE0"/>
    <SolidColorBrush x:Key="BrandPressedBrush" po:Freeze="False" Color="#1A45C4"/>
    <SolidColorBrush x:Key="BrandFillBrush" po:Freeze="False" Color="#EDF2FF"/>
    <SolidColorBrush x:Key="BrandFillHoverBrush" po:Freeze="False" Color="#E0EAFF"/>
    <SolidColorBrush x:Key="AccentBrush" po:Freeze="False" Color="#40A9FF"/>
    <SolidColorBrush x:Key="WindowBgBrush" po:Freeze="False" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="SurfaceBrush" po:Freeze="False" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HairBrush" po:Freeze="False" Color="#E4EAF3"/>
    <SolidColorBrush x:Key="HairStrongBrush" po:Freeze="False" Color="#D9E3F1"/>
    <SolidColorBrush x:Key="OnBrandTextBrush" po:Freeze="False" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrandTextBrush" po:Freeze="False" Color="#1D4FE0"/>
    <SolidColorBrush x:Key="BorderStrongBrush" po:Freeze="False" Color="#CFD9EA"/>
    <SolidColorBrush x:Key="HoverBrush" po:Freeze="False" Color="#F0F4FA"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" po:Freeze="False" Color="#1B2536"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" po:Freeze="False" Color="#5C6B82"/>
    <SolidColorBrush x:Key="TextMutedBrush" po:Freeze="False" Color="#8B97A9"/>
    <SolidColorBrush x:Key="DangerBrush" po:Freeze="False" Color="#DC2626"/>

    <!-- 输入框上方的字段标签 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <!-- v69：下面四支原本在五个页面里各抄了一份，参数一模一样。
         页面级的同名 Style 会盖住这里的，所以各页的那几份已经删掉。 -->
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="FieldLabelTight" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ===== 按钮：默认是安静的次要样式 ===== -->
    <!-- v61：悬停用底色与描边回应，不用投影；按下回沉 1px。 -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" Background="Transparent">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8" Padding="{TemplateBinding Padding}"
                      Effect="{x:Null}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandFillBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="root" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="1"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主操作：底色是一支极淡的上亮下暗渐变，比纯色更有"实体按钮"的厚度 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnBrandTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" Background="Transparent">
              <!-- 内边距交给 ContentPresenter：底色要铺满整个按钮，
                   如果 Padding 留在 Border 上，蓝色底会缩在描边里面一圈 -->
              <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8" Effect="{x:Null}">
                <Grid>
                  <Border x:Name="fill" Background="{DynamicResource BrandBrush}" CornerRadius="7"/>
                  <!-- 顶部高光：一条 20% 白的细边，给纯色按钮一点厚度 -->
                  <Border x:Name="gloss" Height="1" VerticalAlignment="Top" Margin="1,1,1,0"
                          CornerRadius="7,7,0,0" Background="#33FFFFFF"/>
                  <ContentPresenter Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource BrandHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource BrandPressedBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="root" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="1"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource HairStrongBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairStrongBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="gloss" Property="Visibility" Value="Collapsed"/>
                <!-- v68：禁用态底色是 HairStrong，比 TextMuted 深一档的浅色，
                     用 TextMuted 只有 2.28:1，改用 TextSecondary 是 4.18:1 -->
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 带聚焦环的 TextBox ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource BrandFillBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Margin="-2"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <!-- 这里不要再加 Margin=Padding：TextBoxBase 已经给内部的文本视图
                     应用了 Padding，再加一次会让光标双重内缩（v18 对齐错位） -->
                <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="ring" Property="BorderBrush" Value="#402562FF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 与 TextBox 对齐的 PasswordBox ===== -->
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource BrandFillBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Grid>
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Margin="-2"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="ring" Property="BorderBrush" Value="#402562FF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== CheckBox：品牌色对勾 ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="18" Height="18" CornerRadius="4"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path x:Name="check" Data="M 3.5,8.5 L 7,12 L 13.5,4.5" Stroke="White"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 拨动开关（取词开关） ===== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid VerticalAlignment="Center" Width="38" Height="20">
                <Border x:Name="track" CornerRadius="10" Background="{DynamicResource BorderStrongBrush}"/>
                <Ellipse x:Name="thumb" Width="14" Height="14" Fill="White"
                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Grid>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ComboBox：完全自定义的模板（主题模板会和隐式样式打架，
         还会悄悄吞掉点击；这一个的行为是确定的） -->
    <Style TargetType="{x:Type local:FtComboBox}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <!-- v69：FocusVisualStyle 被清空是为了不让默认虚线框压在下拉框的描边上，
                   但键盘 Tab 过来必须还有东西指出焦点在哪，所以自己画一圈。 -->
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2"
                      CornerRadius="10" Margin="-3"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
              <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="Transparent" Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
              <Path x:Name="chevron" IsHitTestVisible="False"
                    Data="M 0,0 L 4.2,4.2 L 8.4,0" Stroke="{DynamicResource TextSecondaryBrush}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,1,14,0" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0"/>
                </Path.RenderTransform>
              </Path>
              <!-- 全程不用 Binding：InvariantGlobalization 会让 WPF 绑定的
                   区域解析抛异常，从而悄悄弄死由 Binding 驱动的 Popup（v15 根因）。
                   Popup 由下面的 IsDropDownOpen 触发器打开；点击走 FtComboBox。 -->
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     PopupAnimation="Fade" Focusable="False">
                <Border MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
                        CornerRadius="9" Margin="0,5,0,0" Padding="4">
                  <Border.Effect>
                    <DropShadowEffect Color="#1B2536" BlurRadius="20" ShadowDepth="4"
                                      Direction="270" Opacity="0.14"/>
                  </Border.Effect>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="PART_Popup" Property="IsOpen" Value="True"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="180"/>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 普通下拉项：品牌色淡底选中，没有 Fluent 的对勾字形 -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                    Padding="10,7" Margin="4,1,4,1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandFillBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 侧边栏（v48 单窗口外壳） -->
    <Style x:Key="SidebarItem" TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- 默认的虚线焦点框会叠在活动高亮上面，看起来像 bug；
           高亮本身已经说明了你在哪个页面。v69：换成外面一圈 2px 品牌色环，
           与 TextBox 的焦点环同一套画法，Tab 过来仍然看得见。 -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- v60：悬停时整行向右挪 2px，读起来像"被手推了一下"；只挪不缩放，
                 侧栏很窄，缩放会挤到右边的角标 -->
            <Grid>
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2"
                      CornerRadius="9" Margin="-1"/>
              <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="8">
                <Grid>
                  <Border x:Name="marker" Width="3" HorizontalAlignment="Left" CornerRadius="1.5"
                          Background="Transparent" Margin="0,9,0,9"/>
                  <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="fill" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform X="2"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 活动项故意重复整个模板：控件模板无法只覆盖继承模板里的某一个元素，
         而这里变的只有左侧那条标记。 -->
    <Style x:Key="SidebarItemActive" TargetType="Button" BasedOn="{StaticResource SidebarItem}">
      <Setter Property="Background" Value="{DynamicResource BrandFillBrush}"/>
      <!-- v69：压在 BrandFill 上的文字用 BrandText，Brand 在这里只有 3.71:1。 -->
      <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="7">
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" CornerRadius="1.5"
                        Background="{DynamicResource BrandBrush}" Margin="0,9,0,9"/>
                <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 侧边栏项上的计数气泡；一位数是圆，三位数会撑成胶囊形 -->
    <Style x:Key="SidebarBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinWidth" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <!-- v61：卡片不加投影。白底、细边框与页面渐变的明度差已经足够分区；
         一圈灰色外发光在浅底上会显脏。 -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14,16,16"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- ===== 四档自评（v61） =====
         默认浅底、悬停加深、选中实色。选中是评分请求期间的持续状态，
         不是只有鼠标按住那一帧；不再用阴影或位移假装层次。 -->
    <Style x:Key="GradeButton" TargetType="Button">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2"
                      CornerRadius="11" Margin="-1"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GradeForgotButton" TargetType="Button" BasedOn="{StaticResource GradeButton}">
      <Setter Property="Background" Value="{DynamicResource GradeForgotFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GradeForgotBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource GradeForgotBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeForgotHoverBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeForgotBrush}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeForgotBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </Trigger>
        <DataTrigger Binding="{Binding SelectedGrade, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="forgot">
          <Setter Property="Background" Value="{DynamicResource GradeForgotBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeForgotBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>


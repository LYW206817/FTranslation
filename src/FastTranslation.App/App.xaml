<Application x:Class="FastTranslation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FastTranslation.App"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Light">
  <Application.Resources>

    <!-- ===== FastTranslation 设计 token（品牌：图标奶油蓝 + #2562FF）=====
         这里每个画刷引用都用 DynamicResource 而不是 StaticResource：ThemeBridge.Apply 在启动时
         给它们重新上色，而 StaticResource 只在解析时查一次——第一次做深色模式的尝试里，
         所有界面都还是浅色，原因正是这个。
         v89：这里的画刷不再带 po:Freeze="False"。ThemeBridge 改成整支替换成冻结画刷，
         元素上的 DynamicResource 会自动重新解析；冻结后的画刷才能走渲染线程的复用路径，
         留着可变画刷等于每帧都把 Freezable 重新序列化一遍（全屏滚动掉帧的直接原因）。 -->
    <SolidColorBrush x:Key="BrandBrush" Color="#2562FF"/>
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#1D4FE0"/>
    <SolidColorBrush x:Key="BrandPressedBrush" Color="#1A45C4"/>
    <SolidColorBrush x:Key="BrandFillBrush" Color="#EDF2FF"/>
    <SolidColorBrush x:Key="BrandFillHoverBrush" Color="#E0EAFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#40A9FF"/>
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HairBrush" Color="#E4EAF3"/>
    <SolidColorBrush x:Key="HairStrongBrush" Color="#D9E3F1"/>
    <SolidColorBrush x:Key="OnBrandTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrandTextBrush" Color="#1D4FE0"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFD9EA"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F4FA"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2536"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6B82"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8B97A9"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

    <!-- v91 效果图 A 的三种底：投放台的柔和径向光、图标砖的浅蓝对角渐变、
         套餐 hero 右列的冷暖薄渐变。XAML 里给浅色默认值，深色由 ThemeBridge 覆盖。 -->
    <RadialGradientBrush x:Key="StageWashBrush" Center="0.5,0.34" GradientOrigin="0.5,0.34"
                         RadiusX="0.78" RadiusY="0.78">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#F2F7FF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TileGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#EFF4FF" Offset="0"/>
      <GradientStop Color="#E1EAFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroPanelBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F7FAFF" Offset="0"/>
      <GradientStop Color="#FFFFFF" Offset="0.6"/>
      <GradientStop Color="#FFF6F2" Offset="1"/>
    </LinearGradientBrush>

    <!-- v91 页头：效果图里每页顶部是 21px 标题 + 一行 12.5px 说明 -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="PageSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- 输入框上方的字段标签 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <!-- v69：下面四支原本在五个页面里各抄了一份，参数一模一样。
         页面级的同名 Style 会盖住这里的，所以各页的那几份已经删掉。 -->
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="FieldLabelTight" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ===== 按钮：默认是安静的次要样式 ===== -->
    <!-- v61：悬停用底色与描边回应，不用投影；按下回沉 1px。 -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" Background="Transparent">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8" Padding="{TemplateBinding Padding}"
                      Effect="{x:Null}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandFillBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="root" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="1"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主操作：底色是一支极淡的上亮下暗渐变，比纯色更有"实体按钮"的厚度 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnBrandTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" Background="Transparent">
              <!-- 内边距交给 ContentPresenter：底色要铺满整个按钮，
                   如果 Padding 留在 Border 上，蓝色底会缩在描边里面一圈 -->
              <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="10" Effect="{DynamicResource NavGlowEffect}">
                <Grid>
                  <Border x:Name="fill" Background="{DynamicResource BrandGradientBrush}" CornerRadius="9"/>
                  <!-- 顶部高光：一条 20% 白的细边，给纯色按钮一点厚度 -->
                  <Border x:Name="gloss" Height="1" VerticalAlignment="Top" Margin="1,1,1,0"
                          CornerRadius="7,7,0,0" Background="#33FFFFFF"/>
                  <ContentPresenter Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- v85：底色已经是渐变，悬停改用透明度压暗——渐变画刷一旦被替换成纯色，
                   按钮就会和侧栏活动项那块渐变色块脱节。 -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="fill" Property="Opacity" Value="0.90"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource BrandPressedBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="root" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="1"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource HairStrongBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairStrongBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="gloss" Property="Visibility" Value="Collapsed"/>
                <!-- v68：禁用态底色是 HairStrong，比 TextMuted 深一档的浅色，
                     用 TextMuted 只有 2.28:1，改用 TextSecondary 是 4.18:1 -->
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 带聚焦环的 TextBox ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource BrandFillBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Margin="-2"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <!-- 这里不要再加 Margin=Padding：TextBoxBase 已经给内部的文本视图
                     应用了 Padding，再加一次会让光标双重内缩（v18 对齐错位） -->
                <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="ring" Property="BorderBrush" Value="#402562FF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 与 TextBox 对齐的 PasswordBox ===== -->
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource BrandFillBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Grid>
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Margin="-2"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="ring" Property="BorderBrush" Value="#402562FF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== CheckBox：品牌色对勾 ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="18" Height="18" CornerRadius="4"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path x:Name="check" Data="M 3.5,8.5 L 7,12 L 13.5,4.5" Stroke="White"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 拨动开关（取词开关） ===== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid VerticalAlignment="Center" Width="38" Height="20">
                <Border x:Name="track" CornerRadius="10" Background="{DynamicResource BorderStrongBrush}"/>
                <Ellipse x:Name="thumb" Width="14" Height="14" Fill="White"
                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Grid>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ComboBox：完全自定义的模板（主题模板会和隐式样式打架，
         还会悄悄吞掉点击；这一个的行为是确定的） -->
    <Style TargetType="{x:Type local:FtComboBox}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <!-- v69：FocusVisualStyle 被清空是为了不让默认虚线框压在下拉框的描边上，
                   但键盘 Tab 过来必须还有东西指出焦点在哪，所以自己画一圈。 -->
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2"
                      CornerRadius="10" Margin="-3"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
              <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="Transparent" Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
              <Path x:Name="chevron" IsHitTestVisible="False"
                    Data="M 0,0 L 4.2,4.2 L 8.4,0" Stroke="{DynamicResource TextSecondaryBrush}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,1,14,0" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0"/>
                </Path.RenderTransform>
              </Path>
              <!-- 全程不用 Binding：InvariantGlobalization 会让 WPF 绑定的
                   区域解析抛异常，从而悄悄弄死由 Binding 驱动的 Popup（v15 根因）。
                   Popup 由下面的 IsDropDownOpen 触发器打开；点击走 FtComboBox。 -->
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     PopupAnimation="Fade" Focusable="False">
                <Border MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
                        CornerRadius="9" Margin="0,5,0,0" Padding="4">
                  <Border.Effect>
                    <DropShadowEffect Color="#1B2536" BlurRadius="20" ShadowDepth="4"
                                      Direction="270" Opacity="0.14"/>
                  </Border.Effect>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="PART_Popup" Property="IsOpen" Value="True"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="180"/>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 普通下拉项：品牌色淡底选中，没有 Fluent 的对勾字形 -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                    Padding="10,7" Margin="4,1,4,1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandFillBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 侧边栏（v48 单窗口外壳） -->
    <Style x:Key="SidebarItem" TargetType="Button">
      <!-- v85：十项要在 660 高的窗口里全部露出来。v48 的 40 高在旧版（侧栏贴边、
           没有品牌区）刚好，加了两团光与浮卡内边距后第 10 项会被底部的取词开关切掉。 -->
      <Setter Property="Height" Value="35"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- 默认的虚线焦点框会叠在活动高亮上面，看起来像 bug；
           高亮本身已经说明了你在哪个页面。v69：换成外面一圈 2px 品牌色环，
           与 TextBox 的焦点环同一套画法，Tab 过来仍然看得见。 -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root">
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2"
                      CornerRadius="12" Margin="-1"/>
              <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="11">
                <ContentPresenter Margin="10,0" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- v85 雾光：悬停底色换成纯白——浮卡本身是半透明白，只有纯白块才托得住；
                   配 v70 用户点名要的那圈 2px 品牌色环。v60 的 2px 右移取消：
                   新侧栏左右各 10px 内边距，再挪就顶到浮卡边上了。 -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
              <!-- v86 活动项：以前是整支 SidebarItemActive 样式（另写一份模板，换页时给十个
                   按钮重新赋 Style，等于把十棵模板树拆了重画）。现在同一份模板里改一个附加属性，
                   点击时模板原地不动。放在悬停触发器之后，活动块上就不叠白色悬停底。
                   v85 的视觉不变：品牌渐变实块 + 同色辉光，整条侧栏里只有它是重色块。 -->
              <DataTrigger Binding="{Binding (local:SidebarState.IsActive), RelativeSource={RelativeSource Self}}"
                           Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource BrandGradientBrush}"/>
                <Setter TargetName="fill" Property="Effect" Value="{DynamicResource NavGlowEffect}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnBrandTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </DataTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- v85：计数从"红点胶囊"换成品牌浅底药丸。侧栏现在是一张半透明浮卡，
         红色小方块在冷暖两色之间跳得太凶；数字读得清就够了，不需要嚷。 -->
    <Style x:Key="SidebarBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BrandFillBrush}"/>
      <!-- v92：9 在 18 高的框上正好是胶囊，和按钮（10）、标签（6）不是一套；
           收到 6，让它和「当前套餐」那枚小标签同一个圆角。 -->
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <!-- v85 改掉 v61 的判断：当年去掉投影的理由是"浅底上一圈灰外发光会显脏"。雾光布局的底
         不是纯白而是一片冷雾渐变，卡片不带影子就贴不住纸面；脏的根源是**中性灰**影子，
         所以阴影色相跟着 Shadow 令牌走，落在蓝底上是加深而不是发灰。 -->
    <!-- v98 试过但已回退：WPF 的 Effect 连子树一起投影，所以想把影子拆到一张没有子元素的
         底板上（FtCard + CardShell 两层）。实测更糟——底板会在卡片四边和四角露出一圈残影，
         圆角写死和 TemplatedParent 绑定两种写法结果一样，回退到单 Border 带 Effect。
         用量环与进度条的观感差异要另找办法，不要再走这条路。 -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Effect" Value="{DynamicResource CardShadowEffect}"/>
      <Setter Property="Padding" Value="18,16,18,18"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- ===== v85 雾光布局的构件 ===== -->

    <!-- 侧栏线性图标：用 Segoe MDL2 Assets 的字形而不是十个 Path——图标只是装饰，
         字形由一个字体统一给出笔画粗细，比手画路径更容易保持一致。Win11 上同名字形
         由 Segoe Fluent Icons 提供，两个字体都列上。颜色不在这里定，让它继承
         Button.Foreground，活动项变成白字时图标跟着变白。 -->
    <Style x:Key="NavIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 主内容区的大卡：没有默认内边距，标题栏/正文/底栏各自由页面摆位。
         v99 去掉 ClipToBounds：矩形裁剪发生在 Effect 之后，会把投影伸出盒外的部分全切掉，
         只在圆角与方角之间留下四块三角残影（用户反馈）。卡内贴边色块要自己收圆角，
         或另包一层带 ClipToBounds 的内 Border 去裁——裁剪和投影不能同一个 Border 兼。
         也别走「把 Effect 拆到无子元素的底板」：v98 末实测会在卡片边缘留一圈残影并已回退。 -->
    <Style x:Key="CardSurface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Effect" Value="{DynamicResource CardShadowEffect}"/>
    </Style>

    <!-- 顶栏那几枚白色标签（语言、模型、积分）。影子比卡片轻一档，
         它们是贴在纸面上的小标签，不该和卡片抢层次。
         v92：圆角 20 → 10。20 在 28 高的框上已经收成胶囊，和按钮（10）、
         输入框（8–10）不是一套语言；10 让它们读成同一族的圆角方框。 -->
    <Style x:Key="TopPill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Effect" Value="{DynamicResource GlassShadowEffect}"/>
    </Style>

    <Style x:Key="PillDot" TargetType="Ellipse">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Height" Value="7"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="{DynamicResource BrandBrush}"/>
    </Style>

    <!-- 快捷键帽：Ctrl / Enter 各一枚，读起来像键盘上的键 -->
    <Style x:Key="Kbd" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BrandFillBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 译文下面那排软胶囊（复制译文 / 存到单词本）。它们是动作，不做成描边按钮，
         免得和主按钮抢注意力。 -->
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource BrandFillBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- v92：与 TopPill 同为 10 圆角，胶囊形状不再出现在任何方框上 -->
            <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource BrandFillHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 页脚那种纯文字动作（截图翻译 / 配置 Key）：没有底色，悬停才亮 -->
    <Style x:Key="FlatLinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Padding" Value="2,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 四档自评（v61） =====
         默认浅底、悬停加深、选中实色。选中是评分请求期间的持续状态，
         不是只有鼠标按住那一帧；不再用阴影或位移假装层次。 -->
    <Style x:Key="GradeButton" TargetType="Button">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2"
                      CornerRadius="11" Margin="-1"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GradeForgotButton" TargetType="Button" BasedOn="{StaticResource GradeButton}">
      <Setter Property="Background" Value="{DynamicResource GradeForgotFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GradeForgotBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource GradeForgotBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeForgotHoverBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeForgotBrush}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeForgotBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </Trigger>
        <DataTrigger Binding="{Binding SelectedGrade, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="forgot">
          <Setter Property="Background" Value="{DynamicResource GradeForgotBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeForgotBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GradeFuzzyButton" TargetType="Button" BasedOn="{StaticResource GradeButton}">
      <Setter Property="Background" Value="{DynamicResource GradeFuzzyFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GradeFuzzyBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource GradeFuzzyBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeFuzzyHoverBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeFuzzyBrush}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeFuzzyBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </Trigger>
        <DataTrigger Binding="{Binding SelectedGrade, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="fuzzy">
          <Setter Property="Background" Value="{DynamicResource GradeFuzzyBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeFuzzyBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GradeFamiliarButton" TargetType="Button" BasedOn="{StaticResource GradeButton}">
      <Setter Property="Background" Value="{DynamicResource GradeFamiliarFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GradeFamiliarBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource GradeFamiliarBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeFamiliarHoverBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeFamiliarBrush}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeFamiliarBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </Trigger>
        <DataTrigger Binding="{Binding SelectedGrade, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="familiar">
          <Setter Property="Background" Value="{DynamicResource GradeFamiliarBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeFamiliarBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GradeKnownButton" TargetType="Button" BasedOn="{StaticResource GradeButton}">
      <Setter Property="Background" Value="{DynamicResource GradeKnownFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GradeKnownBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource GradeKnownBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeKnownHoverBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeKnownBrush}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource GradeKnownBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </Trigger>
        <DataTrigger Binding="{Binding SelectedGrade, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="known">
          <Setter Property="Background" Value="{DynamicResource GradeKnownBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GradeKnownBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource GradeSelectedTextBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

  </Application.Resources>
</Application>

<Window x:Class="FastTranslation.App.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="订阅" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/FastTranslation.ico"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <StackPanel Margin="24,20,24,18">
    <TextBlock x:Name="Headline" FontSize="18" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}"/>
    <TextBlock x:Name="SummaryText" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"/>

    <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
      <StackPanel>
        <StackPanel x:Name="MethodRow" Orientation="Horizontal" Margin="0,0,0,4"/>

        <Image x:Name="QrImage" Width="210" Height="210" Margin="0,10,0,0"
               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

        <TextBlock x:Name="AmountText" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock x:Name="OrderLine" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="InstructionsText" FontSize="11.5" LineHeight="18" Margin="0,10,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="RefLabel" Text="交易单号" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="RefBox" MaxLength="64" Height="34" VerticalContentAlignment="Center"
             TextChanged="RefBox_TextChanged"
             AutomationProperties.Name="交易单号"/>
    <TextBlock x:Name="RefHint" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}"
               Text="从微信 / 支付宝账单详情里把完整交易单号整段粘贴进来。"/>

    <TextBlock x:Name="StatusText" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"/>

    <Grid Margin="0,16,0,0">
      <Button x:Name="CancelOrderButton" Content="取消订单" HorizontalAlignment="Left"
              Padding="12,4" FontSize="12" Click="CancelOrder_Click"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SubmitButton" Content="我已付款" MinWidth="96" Style="{StaticResource PrimaryButton}"
                Click="Submit_Click"/>
        <Button x:Name="CloseButton" Content="关闭" MinWidth="72" Margin="8,0,0,0"
                Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>

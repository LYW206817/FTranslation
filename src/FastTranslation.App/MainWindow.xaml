<Window x:Class="FastTranslation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastTranslation.App"
        Title="Fast Translation" Width="1320" Height="860" Icon="/FastTranslation.ico"
        WindowStartupLocation="CenterScreen" MinWidth="1000" MinHeight="620"
        Background="{DynamicResource PageGradientBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">
  <!-- v189：保留 SingleBorderWindow + GlassFrameThickness=-1，在不破坏 Win11 原生圆角、阴影、
       靠边贴靠与 UIA 窗口名的前提下把雾色渐变和右上角光晕整片铺到窗顶；CaptionHeight 仅覆
       盖 PageHost 上方的 48 DIP 顶区，不拦页面顶栏药丸点击。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="-1"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- 显式覆写 App.xaml 全局 Button 隐式样式的 Margin/Padding/边框，非活动窗口适度柔化图标 -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Opacity" Value="0.58"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Opacity" Value="0.58"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TitleBarCloseIconBrush}"/>
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarClosePressedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TitleBarCloseIconBrush}"/>
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="TransitionHost">
    <!-- v148：把整窗内容（含 PageGradientBrush 底色）包进 ThemeContent，切主题/强调色时先截成
         RenderTargetBitmap 叠在 ThemeTransitionOverlay 上做 220ms 淡出，避免整屏瞬间硬闪。 -->
    <Grid x:Name="ThemeContent" Background="{DynamicResource PageGradientBrush}">
      <!-- v85 雾光：两团光画在整扇窗的最底层。它们只是底色的一层雾，必须
           IsHitTestVisible=False，否则会挡住底下所有按钮。 -->
      <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-120,-90,0" Fill="{DynamicResource GlowBrandBrush}"
               IsHitTestVisible="False"/>
      <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="120,0,0,-160" Fill="{DynamicResource GlowWarmBrush}"
               IsHitTestVisible="False"/>

      <Grid x:Name="WindowChromeRoot">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="214"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 侧栏是一张浮在雾上的半透明卡：底色带 alpha，透出底下渐变的冷暖，
           1px 白描边模拟玻璃边缘的反光。v189 起从窗顶 14px 处起算，与右上控制胶囊顶部对齐。 -->
      <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="14,14,0,14"
              Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
              BorderThickness="1" CornerRadius="14">
        <DockPanel Margin="10,16,10,12">
          <!-- 品牌区：应用自己的图标（v86 换掉原来的渐变方块 + 「译」字，那个方块只是
               没有 logo 时的占位）。图标是 256 那一档，26px 在 200% 缩放下仍然是满分辨率。 -->
          <StackPanel x:Name="BrandHeader" DockPanel.Dock="Top" Orientation="Horizontal"
                      Background="Transparent" Margin="6,2,0,18"
                      MouseLeftButtonDown="BrandHeader_MouseLeftButtonDown">
            <Image Width="26" Height="26" Source="/logo.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Fast Translation" FontSize="13" FontWeight="Bold" Margin="9,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
          </StackPanel>

          <!-- 底部区块：取词开关 + 账号 -->
          <StackPanel DockPanel.Dock="Bottom">
            <Border Height="1" Background="{DynamicResource HairBrush}" Margin="6,8,6,10"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="10,6">
              <CheckBox x:Name="CaptureToggle" Style="{StaticResource ToggleSwitch}" Content="取词已开启"
                        IsChecked="True" Checked="CaptureToggle_Changed" Unchecked="CaptureToggle_Changed"/>
            </Border>
            <TextBlock x:Name="AccountStatus" Text="账号：未登录" Margin="6,9,6,2"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5"/>
          </StackPanel>

          <!-- 十个页面。SyncSidebar 只认这里的直接 Button 子项，分隔条不是 Button，
               所以可以放在同一个 StackPanel 里。 -->
          <StackPanel x:Name="SidebarItems">
            <Button x:Name="HomeButton" AutomationProperties.Name="首页" Style="{StaticResource SidebarItem}"
                    local:SidebarState.IsActive="True" Tag="Home" Click="Nav_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE80F;"/>
                <TextBlock Grid.Column="1" Text="首页" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="WordButton" AutomationProperties.Name="单词" Style="{StaticResource SidebarItem}" Tag="Word" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE8F1;"/>
                <TextBlock Grid.Column="1" Text="单词" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="PhraseButton" AutomationProperties.Name="短语" Style="{StaticResource SidebarItem}" Tag="Phrase" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE8FD;"/>
                <TextBlock Grid.Column="1" Text="短语" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="SentenceButton" AutomationProperties.Name="语句" Style="{StaticResource SidebarItem}" Tag="Sentence" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE7C3;"/>
                <TextBlock Grid.Column="1" Text="语句" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="ReviewButton" AutomationProperties.Name="复习" Style="{StaticResource SidebarItem}" Tag="Review" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE72C;"/>
                <TextBlock Grid.Column="1" Text="复习" VerticalAlignment="Center"/>
                <Border x:Name="ReviewBadge" Grid.Column="2" Style="{StaticResource SidebarBadge}"
                        Visibility="Collapsed">
                  <TextBlock x:Name="ReviewBadgeText" FontSize="10.5" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Foreground="{DynamicResource BrandTextBrush}"/>
                </Border>
              </Grid>
            </Button>
            <Button x:Name="DocumentButton" AutomationProperties.Name="文档" Style="{StaticResource SidebarItem}" Tag="Document" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE8A5;"/>
                <TextBlock Grid.Column="1" Text="文档" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="SpeechButton" AutomationProperties.Name="语音" Style="{StaticResource SidebarItem}" Tag="Speech" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE720;"/>
                <TextBlock Grid.Column="1" Text="语音" VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <Border Height="1" Background="{DynamicResource HairBrush}" Margin="10,10,10,10"/>

            <Button x:Name="PlanButton" AutomationProperties.Name="套餐" Style="{StaticResource SidebarItem}" Tag="Plan" Click="Nav_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE8C7;"/>
                <TextBlock Grid.Column="1" Text="套餐" VerticalAlignment="Center"/>
                <TextBlock x:Name="PlanLabel" Grid.Column="2" VerticalAlignment="Center" FontSize="10.5">
                  <!-- v143：活动项的底色是品牌渐变，PlanLabel 若继续用 TextMutedBrush 会在蓝底上
                       变成深灰字（浅色和深色主题都几乎读不出）。跟着 SidebarItem 的 Foreground 走。 -->
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding (local:SidebarState.IsActive), RelativeSource={RelativeSource AncestorType=Button}}"
                                     Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource OnBrandTextBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Button>
            <Button x:Name="AccountButton" AutomationProperties.Name="账号" Style="{StaticResource SidebarItem}" Tag="Account" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE77B;"/>
                <TextBlock Grid.Column="1" Text="账号" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="SettingsButton" AutomationProperties.Name="设置" Style="{StaticResource SidebarItem}" Tag="Settings" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE713;"/>
                <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

        <!-- 右上角磨砂控制胶囊：呼应左侧玻璃浮卡，与页内 TopPill 留出 22 DIP 垂直呼吸位 -->
        <Border x:Name="CaptionControls" Grid.Column="1" Grid.Row="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                Padding="3" CornerRadius="10"
                Background="{DynamicResource TitleBarGlassBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                    AutomationProperties.Name="最小化" ToolTip="最小化"
                    Click="Minimize_Click">
              <Path Width="10" Height="10" Data="M 1,5 L 9,5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    SnapsToDevicePixels="False"/>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                    AutomationProperties.Name="最大化" ToolTip="最大化"
                    Margin="2,0,0,0" Click="Maximize_Click">
              <Grid Width="10" Height="10">
                <Path x:Name="MaximizeGlyph"
                      Data="M 1,2.6 A 1.6,1.6 0 0 1 2.6,1 L 7.4,1 A 1.6,1.6 0 0 1 9,2.6 L 9,7.4 A 1.6,1.6 0 0 1 7.4,9 L 2.6,9 A 1.6,1.6 0 0 1 1,7.4 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.35" StrokeLineJoin="Round" SnapsToDevicePixels="False"/>
                <Path x:Name="RestoreGlyph" Visibility="Collapsed"
                      Data="M 0.8,4.3 A 1.3,1.3 0 0 1 2.1,3.0 L 5.7,3.0 A 1.3,1.3 0 0 1 7.0,4.3 L 7.0,7.9 A 1.3,1.3 0 0 1 5.7,9.2 L 2.1,9.2 A 1.3,1.3 0 0 1 0.8,7.9 Z M 3.0,3.0 L 3.0,2.1 A 1.3,1.3 0 0 1 4.3,0.8 L 7.9,0.8 A 1.3,1.3 0 0 1 9.2,2.1 L 9.2,5.7 A 1.3,1.3 0 0 1 7.9,7.0 L 7.0,7.0"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      SnapsToDevicePixels="False"/>
              </Grid>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}"
                    AutomationProperties.Name="关闭" ToolTip="关闭"
                    Margin="2,0,0,0" Click="Close_Click">
              <Path Width="10" Height="10" Data="M 1.4,1.4 L 8.6,8.6 M 8.6,1.4 L 1.4,8.6"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    SnapsToDevicePixels="False"/>
            </Button>
          </StackPanel>
        </Border>

        <!-- v212：常驻 Grid 宿主，页面保留在视觉树里只切 Visibility，
             避免 ContentControl 换页反复卸载/重挂载整棵视觉树与重解 DynamicResource。 -->
        <Grid Grid.Column="1" Grid.Row="1" x:Name="PageHost"
              Background="Transparent" Margin="20,0,14,14"/>
      </Grid>
    </Grid>
    <Image x:Name="ThemeTransitionOverlay" Stretch="Fill"
           IsHitTestVisible="False" Visibility="Collapsed"
           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
  </Grid>
</Window>

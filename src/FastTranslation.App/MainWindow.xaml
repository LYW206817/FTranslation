<Window x:Class="FastTranslation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastTranslation.App"
        Title="Fast Translation" Width="1040" Height="660" Icon="/FastTranslation.ico"
        WindowStartupLocation="CenterScreen" MinWidth="900" MinHeight="560"
        Background="{DynamicResource PageGradientBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="172"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 侧边栏 -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarGradientBrush}"
            BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,16,10,12">
        <!-- 品牌区 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
          <Image Source="/icon-master.png" Width="22" Height="22" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Fast Translation" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 底部区块：取词开关 + 账号 -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource HairBrush}" Margin="6,10,6,10"/>
          <CheckBox x:Name="CaptureToggle" Style="{StaticResource ToggleSwitch}" Content="取词已开启"
                    IsChecked="True" Margin="8,0,0,8"
                    Checked="CaptureToggle_Changed" Unchecked="CaptureToggle_Changed"/>
          <TextBlock x:Name="AccountStatus" Text="账号:未登录" Margin="8,0,0,0"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
        </StackPanel>

        <!-- 七个页面 -->
        <StackPanel x:Name="SidebarItems">
          <Button x:Name="HomeButton" Style="{StaticResource SidebarItemActive}" Tag="Home" Click="Nav_Click">
            <TextBlock Text="首页"/>
          </Button>
          <Button x:Name="WordButton" Style="{StaticResource SidebarItem}" Tag="Word" Click="Nav_Click" Margin="0,2,0,0">
            <DockPanel>
              <Border x:Name="WordBadge" DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"
                      Visibility="Collapsed">
                <TextBlock x:Name="WordBadgeText" Foreground="White" FontSize="10" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="单词" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <Button x:Name="PhraseButton" Style="{StaticResource SidebarItem}" Tag="Phrase" Click="Nav_Click" Margin="0,2,0,0">
            <DockPanel>
              <Border x:Name="PhraseBadge" DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"
                      Visibility="Collapsed">
                <TextBlock x:Name="PhraseBadgeText" Foreground="White" FontSize="10" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="短语" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <Button x:Name="SentenceButton" Style="{StaticResource SidebarItem}" Tag="Sentence" Click="Nav_Click" Margin="0,2,0,0">
            <DockPanel>
              <Border x:Name="SentenceBadge" DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"
                      Visibility="Collapsed">
                <TextBlock x:Name="SentenceBadgeText" Foreground="White" FontSize="10" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="语句" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <Button x:Name="ReviewButton" Style="{StaticResource SidebarItem}" Tag="Review" Click="Nav_Click" Margin="0,2,0,0">
            <DockPanel>
              <Border x:Name="ReviewBadge" DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"
                      Visibility="Collapsed">
                <TextBlock x:Name="ReviewBadgeText" Foreground="White" FontSize="10" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="复习" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>

          <Border Height="1" Background="{DynamicResource HairBrush}" Margin="6,10,6,8"/>

          <!-- 套餐 排在 账号 之前：先看买什么，再看自己是谁；套餐名挂在 套餐 那一行，读作「当前套餐」 -->
          <Button x:Name="PlanButton" Style="{StaticResource SidebarItem}" Tag="Plan" Click="Nav_Click">
            <DockPanel>
              <TextBlock x:Name="PlanLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
              <TextBlock Text="套餐" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <Button x:Name="AccountButton" Style="{StaticResource SidebarItem}" Tag="Account" Click="Nav_Click" Margin="0,2,0,0">
            <TextBlock Text="账号"/>
          </Button>
          <Button x:Name="SettingsButton" Style="{StaticResource SidebarItem}" Tag="Settings" Click="Nav_Click" Margin="0,2,0,0">
            <TextBlock Text="设置"/>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 页面宿主：一个 ContentControl，页面是按需创建的 UserControl。
         页面自己不带底色（Transparent），底下的渐变由窗口提供——换页时整块渐变不闪。 -->
    <ContentControl Grid.Column="1" x:Name="PageHost" Background="Transparent"/>
  </Grid>
</Window>

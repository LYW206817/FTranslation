<Window x:Class="FastTranslation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastTranslation.App"
        Title="Fast Translation" Width="1320" Height="860" Icon="/FastTranslation.ico"
        WindowStartupLocation="CenterScreen" MinWidth="1000" MinHeight="620"
        Background="{DynamicResource PageGradientBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">
  <Grid>
    <!-- v85 雾光：两团光画在整扇窗的最底层。它们只是底色的一层雾，必须
         IsHitTestVisible=False，否则会挡住底下所有按钮。 -->
    <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,-120,-90,0" Fill="{DynamicResource GlowBrandBrush}"
             IsHitTestVisible="False"/>
    <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Bottom"
             Margin="120,0,0,-160" Fill="{DynamicResource GlowWarmBrush}"
             IsHitTestVisible="False"/>

    <Grid Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 侧栏是一张浮在雾上的半透明卡：底色带 alpha，透出底下渐变的冷暖，
           1px 白描边模拟玻璃边缘的反光。 -->
      <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
              BorderThickness="1" CornerRadius="14" Effect="{DynamicResource GlassShadowEffect}">
        <DockPanel Margin="10,16,10,12">
          <!-- 品牌区：应用自己的图标（v86 换掉原来的渐变方块 + 「译」字，那个方块只是
               没有 logo 时的占位）。图标是 256 那一档，26px 在 200% 缩放下仍然是满分辨率。 -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,18">
            <Image Width="26" Height="26" Source="/logo.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Fast Translation" FontSize="13" FontWeight="Bold" Margin="9,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
          </StackPanel>

          <!-- 底部区块：取词开关 + 账号 -->
          <StackPanel DockPanel.Dock="Bottom">
            <Border Height="1" Background="{DynamicResource HairBrush}" Margin="6,8,6,10"/>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="10,6"
                    Effect="{DynamicResource GlassShadowEffect}">
              <CheckBox x:Name="CaptureToggle" Style="{StaticResource ToggleSwitch}" Content="取词已开启"
                        IsChecked="True" Checked="CaptureToggle_Changed" Unchecked="CaptureToggle_Changed"/>
            </Border>
            <TextBlock x:Name="AccountStatus" Text="账号:未登录" Margin="6,9,6,2"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5"/>
          </StackPanel>

          <!-- 八个页面。SyncSidebar 只认这里的直接 Button 子项，分隔条不是 Button，
               所以可以放在同一个 StackPanel 里。 -->
          <StackPanel x:Name="SidebarItems">
            <Button x:Name="HomeButton" AutomationProperties.Name="首页" Style="{StaticResource SidebarItem}"
                    local:SidebarState.IsActive="True" Tag="Home" Click="Nav_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE80F;"/>
                <TextBlock Grid.Column="1" Text="首页" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="WordButton" AutomationProperties.Name="单词" Style="{StaticResource SidebarItem}" Tag="Word" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE8F1;"/>
                <TextBlock Grid.Column="1" Text="单词" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="PhraseButton" AutomationProperties.Name="短语" Style="{StaticResource SidebarItem}" Tag="Phrase" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE8FD;"/>
                <TextBlock Grid.Column="1" Text="短语" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="SentenceButton" AutomationProperties.Name="语句" Style="{StaticResource SidebarItem}" Tag="Sentence" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE7C3;"/>
                <TextBlock Grid.Column="1" Text="语句" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="ReviewButton" AutomationProperties.Name="复习" Style="{StaticResource SidebarItem}" Tag="Review" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE72C;"/>
                <TextBlock Grid.Column="1" Text="复习" VerticalAlignment="Center"/>
                <Border x:Name="ReviewBadge" Grid.Column="2" Style="{StaticResource SidebarBadge}"
                        Visibility="Collapsed">
                  <TextBlock x:Name="ReviewBadgeText" FontSize="10.5" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Foreground="{DynamicResource BrandTextBrush}"/>
                </Border>
              </Grid>
            </Button>
            <Button x:Name="DocumentButton" AutomationProperties.Name="文档" Style="{StaticResource SidebarItem}" Tag="Document" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE8A5;"/>
                <TextBlock Grid.Column="1" Text="文档" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="SpeechButton" AutomationProperties.Name="语音" Style="{StaticResource SidebarItem}" Tag="Speech" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE720;"/>
                <TextBlock Grid.Column="1" Text="语音" VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <Border Height="1" Background="{DynamicResource HairBrush}" Margin="10,10,10,10"/>

            <Button x:Name="PlanButton" AutomationProperties.Name="套餐" Style="{StaticResource SidebarItem}" Tag="Plan" Click="Nav_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE8C7;"/>
                <TextBlock Grid.Column="1" Text="套餐" VerticalAlignment="Center"/>
                <TextBlock x:Name="PlanLabel" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5"/>
              </Grid>
            </Button>
            <Button x:Name="AccountButton" AutomationProperties.Name="账号" Style="{StaticResource SidebarItem}" Tag="Account" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE77B;"/>
                <TextBlock Grid.Column="1" Text="账号" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="SettingsButton" AutomationProperties.Name="设置" Style="{StaticResource SidebarItem}" Tag="Settings" Click="Nav_Click" Margin="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE713;"/>
                <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 页面宿主：一个 ContentControl，页面是按需创建的 UserControl。
           页面自己不带底色（Transparent），底下的雾色由窗口提供——换页时整块渐变不闪。 -->
      <ContentControl Grid.Column="1" x:Name="PageHost" Background="Transparent" Margin="20,0,0,0"/>
    </Grid>
  </Grid>
</Window>

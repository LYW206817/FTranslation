<Window x:Class="FastTranslation.App.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fast Translation" Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/FastTranslation.ico"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <StackPanel Margin="24,20,24,18">

    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Image Source="/icon-master.png" Width="20" Height="20" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock x:Name="Headline" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>

    <TextBlock x:Name="BodyText" FontSize="13" LineHeight="21" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"/>

    <StackPanel x:Name="LinkRow" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
      <Button x:Name="LinkButton" Padding="10,4" FontSize="12" Margin="0"
              Click="Link_Click"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelAction" Content="取消" Margin="0,0,8,0" Visibility="Collapsed"
              Click="Cancel_Click"/>
      <Button x:Name="PrimaryAction" Content="好" MinWidth="88" Style="{StaticResource PrimaryButton}"
              Margin="0" Click="Primary_Click"/>
    </StackPanel>
  </StackPanel>
</Window>

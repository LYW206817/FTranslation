<Window x:Class="FastTranslation.App.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/FastTranslation.ico"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12,14,14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="FieldLabelTight" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="MeterBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="3" HorizontalAlignment="Left"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,20,24,18">

    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <Image Source="/icon-master.png" Width="20" Height="20" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock x:Name="Headline" Text="登录账号" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>

    <!-- ================= signed out ================= -->
    <StackPanel x:Name="SignedOutPanel">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="EmailLabel" Text="邮箱" Style="{StaticResource FieldLabelTight}"/>
          <TextBox x:Name="EmailBox" AutomationProperties.Name="邮箱"
                   TextChanged="Input_Changed"/>
          <TextBlock Text="密码" Style="{StaticResource FieldLabelTight}" Margin="0,12,0,6"/>
          <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="密码"
                       PasswordChanged="Password_Changed"/>
          <TextBlock x:Name="PasswordHint" Style="{StaticResource Hint}"
                     Text="至少 8 位。忘记密码暂时需要联系我们重置。"/>

          <StackPanel x:Name="CodeRow" Visibility="Collapsed">
            <TextBlock Text="邮箱验证码" Style="{StaticResource FieldLabelTight}" Margin="0,12,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="CodeBox" AutomationProperties.Name="验证码" MaxLength="6"/>
              <Button x:Name="SendCodeButton" Grid.Column="1" Content="获取验证码" Margin="8,0,0,0"
                      Style="{StaticResource SmallButton}" Click="SendCode_Click"/>
            </Grid>
            <TextBlock x:Name="CodeHint" Style="{StaticResource Hint}"
                       Text="验证码 10 分钟内有效,会发到上面的邮箱。"/>
          </StackPanel>

          <TextBlock x:Name="ErrorText" Style="{StaticResource Hint}"
                     Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SwitchButton" Content="去注册" Click="Switch_Click"/>
            <Button x:Name="SubmitButton" Content="登录" MinWidth="96" Margin="0"
                    Style="{StaticResource PrimaryButton}" Click="Submit_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="2,0,2,0"
                 Text="登录后就能看到自己的免费额度用量。"/>
    </StackPanel>

    <!-- ================= signed in ================= -->
    <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="AccountEmail" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
          <TextBlock x:Name="PlanText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="本月用量" Style="{StaticResource FieldLabelTight}"/>
          <TextBlock x:Name="MonthlyText" FontSize="13"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <ProgressBar x:Name="MonthlyBar" Style="{StaticResource MeterBar}"/>

          <StackPanel x:Name="DailyRow" Margin="0,14,0,0">
            <TextBlock Text="今日用量" Style="{StaticResource FieldLabelTight}"/>
            <TextBlock x:Name="DailyText" FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <ProgressBar x:Name="DailyBar" Style="{StaticResource MeterBar}"/>
          </StackPanel>

          <TextBlock x:Name="UsageError" Style="{StaticResource Hint}"
                     Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="RefreshButton" Content="刷新用量" Click="Refresh_Click"/>
        <Button x:Name="SignOutButton" Content="退出登录" Margin="0" Click="SignOut_Click"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CloseButton" Content="关闭" Margin="0" Click="Close_Click"/>
    </StackPanel>
  </StackPanel>
</Window>

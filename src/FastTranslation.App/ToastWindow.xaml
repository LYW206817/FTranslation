<Window x:Class="FastTranslation.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Topmost="True" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <!-- 非模态提示条：模态 NoticeWindow 会冻结取词工具栏与结果卡（单 UI 线程），
       而「注册成功」这种一句话反馈不值得打断用户，所以自己 3 秒消失。
       ShowActivated=False：弹出时不抢键盘焦点，用户正在输入的内容不会被打断。 -->
  <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" Margin="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22"/>
    </Border.Effect>
    <Grid Margin="14,11,12,11">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="MessageText" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <Button x:Name="ActionButton" Grid.Column="1" Content="去登录" Style="{StaticResource PrimaryButton}"
              Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
              Click="Action_Click"/>
    </Grid>
  </Border>
</Window>

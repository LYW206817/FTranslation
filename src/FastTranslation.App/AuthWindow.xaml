<Window x:Class="FastTranslation.App.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastTranslation.App"
        xmlns:win="clr-namespace:FastTranslation.Platform.Windows;assembly=FastTranslation.Platform.Windows"
        Title="登录 — Fast Translation" Width="456" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="/FastTranslation.ico"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Focusable="False" FocusVisualStyle="{x:Null}"
                win:ScrollViewerWheel.Forward="True">
    <local:AuthPanel x:Name="AuthForm"/>
  </ScrollViewer>
</Window>

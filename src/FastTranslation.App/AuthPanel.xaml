<UserControl x:Class="FastTranslation.App.AuthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <UserControl.Resources>
    <!-- 分段切换标签：在 Login / Register 间一键切换，比页脚小字更直观 -->
    <Style x:Key="SegmentTab" TargetType="RadioButton">
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="ring" BorderBrush="Transparent" BorderThickness="2"
                      CornerRadius="9" Margin="-2"/>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="7">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource GlassShadowEffect}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlaceholderText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Opacity" Value="0.72"/>
      <Setter Property="Margin" Value="14,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
  </UserControl.Resources>

  <!-- 独立弹窗时铺满窗口避免「窗内套卡」的双层边框；嵌在账号页时居中显示为单栏卡片。
       装饰雾光放进 ClipToBounds 的内层 Grid，外层 Border 只管描边与阴影，避免四角出现裁切残影。 -->
  <Border x:Name="CardShell" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
          CornerRadius="12" Effect="{DynamicResource CardShadowEffect}"
          Width="460" HorizontalAlignment="Center">
    <Grid>
      <!-- 顶部冷雾渐变：跟着当前主题 BrandFill 自动变色，向下淡出进 SurfaceBrush -->
      <Grid Height="170" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
        <Border Background="{DynamicResource BrandFillBrush}" Opacity="0.75">
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FF000000" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Border.OpacityMask>
        </Border>
      </Grid>

      <StackPanel Margin="32,26,32,22">
        <!-- 品牌头：独立弹窗居中展示图标砖与标题；账号页本身已有页头，嵌入时收起 -->
        <StackPanel x:Name="AppHeader" Margin="0,0,0,18" HorizontalAlignment="Center" Visibility="Collapsed">
          <Border Width="46" Height="46" CornerRadius="12" HorizontalAlignment="Center"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
                  Effect="{DynamicResource GlassShadowEffect}">
            <Image Width="28" Height="28" Source="/logo.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock x:Name="FormTitle" Text="登录 Fast Translation" FontSize="19" FontWeight="SemiBold"
                     Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock x:Name="ModeHint" FontSize="12.5" Margin="0,5,0,0" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="登录后使用划词、截图与云端单词本。"/>
        </StackPanel>

        <!-- 登录 / 注册分段切换 -->
        <Border x:Name="ModeTabsBar" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
                CornerRadius="10" Padding="4" Margin="0,0,0,18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="LoginTab" Grid.Column="0" Content="账号登录"
                         Style="{StaticResource SegmentTab}" Checked="ModeTab_Checked"/>
            <RadioButton x:Name="RegisterTab" Grid.Column="1" Content="注册账号"
                         Style="{StaticResource SegmentTab}" Checked="ModeTab_Checked"/>
          </Grid>
        </Border>

        <!-- 重置密码返回栏 -->
        <StackPanel x:Name="ResetNavRow" Margin="0,0,0,14" Visibility="Collapsed">
          <Button x:Name="BackToLoginButton" HorizontalAlignment="Left" Padding="2,4"
                  Style="{StaticResource FlatLinkButton}" Click="BackToLogin_Click">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 5,0 L 0,4.5 L 5,9 M 0.5,4.5 L 11,4.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,1,6,0"/>
              <TextBlock Text="返回登录" FontSize="12.5" FontWeight="Medium"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 邮箱 -->
        <TextBlock Text="邮箱" Style="{StaticResource FieldLabelTight}" Margin="0,0,0,6"/>
        <Grid>
          <TextBox x:Name="EmailBox" Height="40" FontSize="13.5"
                   AutomationProperties.Name="邮箱" TextChanged="Input_Changed"/>
          <TextBlock x:Name="EmailPlaceholder" Text="name@example.com" Style="{StaticResource PlaceholderText}"/>
        </Grid>

        <!-- 密码（右侧按模式放「忘记密码？」或「至少 8 位」，省出整行视觉留白） -->
        <Grid Margin="0,14,0,6">
          <TextBlock x:Name="PasswordLabelText" Text="密码" Style="{StaticResource FieldLabelTight}"
                     Margin="0" VerticalAlignment="Center"/>
          <Button x:Name="ForgotPasswordButton" Content="忘记密码？" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Margin="0" FontSize="12" Padding="2,1"
                  Foreground="{DynamicResource BrandTextBrush}"
                  Style="{StaticResource FlatLinkButton}" Click="ForgotPassword_Click"/>
          <TextBlock x:Name="PasswordHint" Text="至少 8 位" HorizontalAlignment="Right"
                     VerticalAlignment="Center" FontSize="11.5" Visibility="Collapsed"
                     Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>
        <Grid>
          <PasswordBox x:Name="PasswordBox" Height="40" FontSize="13.5"
                       AutomationProperties.Name="密码" PasswordChanged="Password_Changed"/>
          <TextBlock x:Name="PasswordPlaceholder" Text="输入密码" Style="{StaticResource PlaceholderText}"/>
        </Grid>

        <!-- 确认新密码（重置密码模式） -->
        <StackPanel x:Name="ConfirmPasswordRow" Visibility="Collapsed" Margin="0,14,0,0">
          <TextBlock Text="确认新密码" Style="{StaticResource FieldLabelTight}" Margin="0,0,0,6"/>
          <Grid>
            <PasswordBox x:Name="ResetConfirmPasswordBox" Height="40" FontSize="13.5"
                         AutomationProperties.Name="确认新密码" PasswordChanged="Password_Changed"/>
            <TextBlock x:Name="ConfirmPasswordPlaceholder" Text="再次输入新密码"
                       Style="{StaticResource PlaceholderText}"/>
          </Grid>
        </StackPanel>

        <!-- 邮箱验证码（注册需验证 / 重置密码） -->
        <StackPanel x:Name="CodeRow" Visibility="Collapsed" Margin="0,14,0,0">
          <TextBlock Text="邮箱验证码" Style="{StaticResource FieldLabelTight}" Margin="0,0,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="CodeBox" Height="40" FontSize="13.5"
                       AutomationProperties.Name="验证码" MaxLength="6" TextChanged="Input_Changed"/>
              <TextBlock x:Name="CodePlaceholder" Text="6 位验证码" Style="{StaticResource PlaceholderText}"/>
            </Grid>
            <Button x:Name="SendCodeButton" Grid.Column="1" Content="获取验证码"
                    Height="40" MinWidth="104" Margin="8,0,0,0" Padding="14,0" FontSize="12.5"
                    Click="SendCode_Click"/>
          </Grid>
          <TextBlock x:Name="CodeHint" Style="{StaticResource Hint}" Margin="0,6,0,0"
                     Text="验证码 10 分钟内有效，会发到上面的邮箱。"/>
        </StackPanel>

        <TextBlock x:Name="ResetHint" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,6,0,0"
                   Text="若该邮箱未注册，不会收到邮件；重置后其他设备需重新登录。"/>

        <!-- 错误横幅：弱红底 + 描边比裸红字更易扫读 -->
        <Border x:Name="ErrorBanner" Visibility="Collapsed" Margin="0,14,0,0"
                Background="#14DC2626" BorderBrush="#40DC2626" BorderThickness="1"
                CornerRadius="8" Padding="11,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path Data="M 7,1 A 6,6 0 1 0 7,13 A 6,6 0 1 0 7,1 Z M 7,4 L 7,7.5 M 7,9.6 L 7,10.2"
                  Width="14" Height="14" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="ErrorText" Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
          </Grid>
        </Border>

        <Button x:Name="SubmitButton" Content="登录" Height="42" Margin="0,20,0,0"
                FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch"
                Style="{StaticResource PrimaryButton}" Click="Submit_Click"/>

        <!-- 底部轻量权益栏：不抢主按钮重心 -->
        <Border Height="1" Background="{DynamicResource HairBrush}" Margin="0,20,0,14"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="11" Foreground="{DynamicResource BrandBrush}"
                       VerticalAlignment="Center" Margin="0,1,5,0"/>
            <TextBlock Text="免费额度随账号" FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="11" Foreground="{DynamicResource BrandBrush}"
                       VerticalAlignment="Center" Margin="0,1,5,0"/>
            <TextBlock Text="单词本云同步" FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="11" Foreground="{DynamicResource BrandBrush}"
                       VerticalAlignment="Center" Margin="0,1,5,0"/>
            <TextBlock Text="最多 3 台设备" FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>

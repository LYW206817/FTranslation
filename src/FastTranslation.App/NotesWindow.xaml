<Window x:Class="FastTranslation.App.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="单词本" Width="820" Height="560" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" Icon="/FastTranslation.ico"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- the three shelves: a quiet vertical list, selected one tinted brand -->
    <Style x:Key="ShelfButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ShelfButtonActive" TargetType="Button" BasedOn="{StaticResource ShelfButton}">
      <Setter Property="Background" Value="{DynamicResource BrandFillBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="NoteRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <!-- without this the row name falls back to record ToString(), which a screen reader
           would read out as raw field assignments -->
      <Setter Property="AutomationProperties.Name" Value="{Binding SourceText}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandFillBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NotesList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource NoteRow}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="Auto">
              <ItemsPresenter/>
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- header: title + search -->
    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="/icon-master.png" Width="20" Height="20"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="Headline" Text="单词本" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Width="220" AutomationProperties.Name="搜索"
                 TextChanged="Search_Changed"/>
        <Button x:Name="RefreshButton" Content="刷新" Margin="8,0,0,0" Click="Refresh_Click"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/>
        <ColumnDefinition Width="*" MinWidth="220"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- left: the three shelves -->
      <StackPanel Grid.Column="0">
        <Button x:Name="WordButton" Content="单词" Style="{StaticResource ShelfButtonActive}"
                Click="Shelf_Click" Tag="word"/>
        <Button x:Name="PhraseButton" Content="短语" Style="{StaticResource ShelfButton}"
                Click="Shelf_Click" Tag="phrase"/>
        <Button x:Name="SentenceButton" Content="语句" Style="{StaticResource ShelfButton}"
                Click="Shelf_Click" Tag="sentence"/>
      </StackPanel>

      <!-- middle: the list -->
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
              BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" Padding="6">
        <Grid>
          <ListBox x:Name="NotesList" Style="{StaticResource NotesList}"
                   SelectionChanged="Notes_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding SourceText}" FontSize="13" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="{Binding TargetText}" FontSize="12" Margin="0,3,0,0"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="{Binding OriginLine}" FontSize="11" Margin="0,3,0,0"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center"
                     VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" MaxWidth="220"
                     TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>
      </Border>

      <!-- right: detail -->
      <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
              BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" Padding="14,12,14,14">
        <Grid>
          <TextBlock x:Name="DetailEmpty" Text="从左边选一条看看。" FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
          <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="原文" Style="{StaticResource FieldLabel}"/>
              <TextBlock x:Name="DetailSource" FontSize="14" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="译文" Style="{StaticResource FieldLabel}"/>
              <TextBlock x:Name="DetailTarget" FontSize="14" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="类型" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="KindCombo" SelectionChanged="Kind_Changed">
                <ComboBoxItem Content="单词" Tag="word"/>
                <ComboBoxItem Content="短语" Tag="phrase"/>
                <ComboBoxItem Content="语句" Tag="sentence"/>
              </ComboBox>
              <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                       AutomationProperties.Name="备注"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="SaveNoteButton" Content="保存备注" Click="SaveNote_Click"/>
                <Button x:Name="DeleteButton" Content="删除" Margin="0" Click="Delete_Click"/>
              </StackPanel>
              <TextBlock x:Name="DetailStatus" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
              <TextBlock Text="来源" Style="{StaticResource FieldLabel}"/>
              <TextBlock x:Name="DetailOrigin" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

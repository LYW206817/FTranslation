<Window x:Class="FastTranslation.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="470" Height="340" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/FastTranslation.ico"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- v69：标题字号收敛到 17，与其余四扇窗和五个页面的标题同一档 -->
    <TextBlock Grid.Row="0" x:Name="Headline" FontSize="17" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}"/>

    <TextBlock Grid.Row="1" x:Name="Subline" Margin="0,6,0,0" FontSize="12"
               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

    <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="NotesText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1" Visibility="Collapsed"
                   Background="{DynamicResource HairBrush}" Foreground="{DynamicResource BrandBrush}"
                   BorderThickness="0"/>
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}"/>
    </StackPanel>

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" x:Name="LaterButton" Content="稍后" Width="88" Margin="0,0,8,0"
              Click="Later_Click"/>
      <Button Grid.Column="2" x:Name="ApplyButton" Content="立即更新" Width="104"
              Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
    </Grid>
  </Grid>
</Window>

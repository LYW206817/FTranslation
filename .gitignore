# 构建产物
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# 发布产物（由 tools/qa 与 dotnet publish 重新生成）
publish/

# tools/qa 脚本抓的 QA 截图（是生成物，不是源码）
assets/qa/

# 本地运行时状态，绝不能提交
*.bin
settings.json
install.log
*.wixpdb
# 服务端生产密钥（示例文件入库，真实文件不入库）
appsettings.Production.json
# 服务端运行时状态（SQLite 数据库与 WAL 文件只在本地，绝不提交）
server/**/data/
*.db
*.db-wal
*.db-shm

# Qoder IDE 生成的仓库快照，属于本地工具产物
/.qoder/
